---
import SiteFooter from "@components/SiteFooter.astro";
import SiteHeader from "@components/SiteHeader.astro";
import type { Locale, SiteContent } from "@lib/content";
import "@fontsource-variable/space-grotesk";
import "@fontsource-variable/jetbrains-mono";
import "@styles/tokens.css";
import "@styles/base.css";
import "@styles/layout.css";
import "@styles/motion.css";
import "@styles/surfaces.css";

type Props = {
  content: SiteContent;
  locale: Locale;
  alternatePath: string;
  title?: string;
  description?: string;
};

const { content, locale, alternatePath, title, description } = Astro.props;
const pageTitle = title ? `${title} | X32 Studio` : content.meta.title;
const pageDescription = description ?? content.meta.description;
const siteOrigin = Astro.site?.toString().replace(/\/$/, "") ?? "https://x32studio.com";
const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? siteOrigin);
const ogImageUrl = new URL("/og-image.png", Astro.site ?? siteOrigin);
const ogLocale = locale === "zh" ? "zh_CN" : "en_US";

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": `${siteOrigin}/#organization`,
      name: "X32 Studio",
      alternateName: ["x32 studio", "X32Studio", "X32 工作室"],
      url: `${siteOrigin}/`,
      logo: new URL("/favicon.svg", Astro.site ?? siteOrigin).toString(),
      description:
        "One-person AI engineering studio founded by Ruiyuan Kang (k-r33) building self-loop, System of Skills, Argus, and Agent DAO.",
      founder: { "@id": `${siteOrigin}/#founder` },
      sameAs: ["https://github.com/X32Studio", "https://github.com/X32Studio/self-loop"],
    },
    {
      "@type": "Person",
      "@id": `${siteOrigin}/#founder`,
      name: "Ruiyuan Kang",
      alternateName: "k-r33",
      jobTitle:
        "AI Startup CxO · DRI & OPC · Former Head of AI Agent Department at TII (UAE) · Founder at X32 Studio",
      description:
        "Building Organizational Intelligence and Carbon-Silicon Hybrid Intelligence from Strategy to Delivery. Former Head of AI Agent Department at Technology Innovation Institute (TII, UAE).",
      url: "https://k-r33.github.io",
      worksFor: { "@id": `${siteOrigin}/#organization` },
      sameAs: [
        "https://github.com/k-r33",
        "https://k-r33.github.io",
        "https://github.com/X32Studio",
      ],
    },
  ],
};
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <script is:inline>
      document.documentElement.classList.add("js");
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta
      name="keywords"
      content="X32 Studio, Ruiyuan Kang, k-r33, self-loop, Argus, System of Skills, Agent DAO, one-person AI studio, OPC, DRI, agentic engineering, Organizational Intelligence, Carbon-Silicon Hybrid Intelligence, 一人公司, 组织智能"
    />
    <meta name="author" content="Ruiyuan Kang (k-r33) · X32 Studio" />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#07080a" />
    <link rel="canonical" href={canonicalUrl} />
    <link
      rel="alternate"
      hreflang={locale === "en" ? "zh" : "en"}
      href={new URL(alternatePath, Astro.site ?? siteOrigin)}
    />
    <link rel="alternate" hreflang="x-default" href={Astro.site ?? siteOrigin} />
    <link rel="sitemap" href="/sitemap.xml" />
    <link rel="alternate" type="application/rss+xml" title="X32 Studio" href="/rss.xml" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="X32 Studio" />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:locale:alternate" content={locale === "zh" ? "en_US" : "zh_CN"} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={ogImageUrl} />
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} is:inline />
  </head>
  <body>
    <div class="page-shell">
      <SiteHeader content={content} locale={locale} alternatePath={alternatePath} />
      <main id="top">
        <slot />
      </main>
      <SiteFooter content={content} locale={locale} />
    </div>

    <script>
      const reveals = document.querySelectorAll(".reveal");
      if ("IntersectionObserver" in window) {
        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add("is-visible");
                observer.unobserve(entry.target);
              }
            }
          },
          { threshold: 0.08, rootMargin: "0px 0px -24px 0px" },
        );
        for (const element of reveals) {
          observer.observe(element);
        }
      } else {
        for (const element of reveals) {
          element.classList.add("is-visible");
        }
      }
    </script>
  </body>
</html>
