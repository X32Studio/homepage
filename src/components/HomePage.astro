---
import ChaosToOrderBand from "@components/ChaosToOrderBand.astro";
import Hero from "@components/Hero.astro";
import ProjectCard from "@components/ProjectCard.astro";
import StackSection from "@components/StackSection.astro";
import BaseLayout from "@layouts/BaseLayout.astro";
import { formatPostDate, getAlternateLocalePath, getSiteContent, type Locale } from "@lib/content";
import { getCollection } from "astro:content";

type Props = {
  locale: Locale;
};

const { locale } = Astro.props;
const content = getSiteContent(locale);
const alternatePath = getAlternateLocalePath(locale, Astro.url.pathname);

const allProjects = await getCollection(
  "projects",
  ({ data }) => data.visibility === "public" && data.locale === locale,
);
allProjects.sort((left, right) => left.data.order - right.data.order);

const posts = (await getCollection("blog", ({ data }) => !data.draft && data.locale === locale)).sort(
  (left, right) => right.data.pubDate.valueOf() - left.data.pubDate.valueOf(),
);

const projectsHref = locale === "zh" ? "/zh/projects/" : "/projects/";
const blogHref = locale === "zh" ? "/zh/blog/" : "/blog/";
const allProjectsLabel = locale === "zh" ? "全部公开项目 →" : "All projects →";
const allNotesLabel = locale === "zh" ? "全部航行笔记 →" : "All notes →";
const langTag = locale === "zh" ? "中文" : "EN";
---

<BaseLayout content={content} locale={locale} alternatePath={alternatePath}>
  <Hero content={content} />
  <ChaosToOrderBand locale={locale} />
  <StackSection locale={locale} />

  <section class="section">
    <div class="container">
      <div class="section-head reveal">
        <div>
          <p class="eyebrow">{content.projectsIntro.eyebrow}</p>
          <h2>{content.projectsIntro.title}</h2>
        </div>
        <a class="more" href={projectsHref}>{allProjectsLabel}</a>
      </div>
      <div class="project-grid">
        {
          allProjects.map((project, index) => (
            <div class="reveal" data-delay={String((index % 4) + 1)}>
              <ProjectCard project={project} />
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head reveal">
        <div>
          <p class="eyebrow">{content.blogIntro.eyebrow}</p>
          <h2>{content.blogIntro.title}</h2>
        </div>
        <a class="more" href={blogHref}>{allNotesLabel}</a>
      </div>
      <div class="post-surface reveal">
        {
          posts.slice(0, 4).map((post) => (
            <article class="post-row">
              <time datetime={post.data.pubDate.toISOString()}>{formatPostDate(post.data.pubDate)}</time>
              <h3>
                <a href={`${blogHref}${post.data.postSlug}/`}>{post.data.title}</a>
              </h3>
              <span class="lang-tag">{langTag}</span>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="hud-frame about-panel reveal">
        <div class="about-copy">
          <p class="eyebrow">{content.aboutTeaser.eyebrow}</p>
          <h2>{content.aboutTeaser.title}</h2>
          <p class="role-line">{content.aboutTeaser.roleLine}</p>
          <p class="prev-line mono-metric">{content.aboutTeaser.previousLine}</p>
          <p class="body">{content.aboutTeaser.body}</p>
          <div class="about-actions">
            <a class="btn btn-primary" href={content.aboutTeaser.cta.href}>
              {content.aboutTeaser.cta.label} →
            </a>
            <a
              class="btn btn-ghost"
              href={content.aboutTeaser.secondaryCta.href}
              target="_blank"
              rel="noopener noreferrer"
            >
              {content.aboutTeaser.secondaryCta.label} ↗
            </a>
            <a
              class="btn btn-ghost"
              href="https://k-r33.github.io"
              target="_blank"
              rel="noopener noreferrer"
            >
              k-r33.github.io ↗
            </a>
          </div>
        </div>

        <div class="about-side">
          <p class="side-label mono-metric">
            {locale === "zh" ? "FOCUS // 长期研究与交付方向" : "FOCUS // MISSION DIRECTIONS"}
          </p>
          <ul class="capabilities">
            {content.aboutTeaser.capabilities.map((item) => <li>{item}</li>)}
          </ul>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .post-surface {
    border-top: 1px solid var(--color-line);
  }

  .about-panel {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(0, 0.85fr);
    gap: clamp(1.75rem, 4.5vw, 3.5rem);
    align-items: center;
    padding: clamp(1.6rem, 4.2vw, 3rem);
  }

  .about-copy h2 {
    font-size: clamp(1.55rem, 3.2vw, 2.25rem);
    margin-top: 0.65rem;
  }

  .role-line {
    margin-top: 0.85rem;
    color: var(--color-cyan);
    font-size: 0.96rem;
    font-weight: 500;
  }

  .prev-line {
    margin-top: 0.25rem;
    color: var(--color-ink-faint);
    font-size: 0.78rem;
  }

  .about-copy .body {
    color: var(--color-ink-soft);
    margin-block: 1rem 1.5rem;
    max-width: 58ch;
  }

  .about-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .about-side {
    padding: 1.25rem;
    border-radius: var(--radius-md);
    border: 1px solid var(--color-line-subtle);
    background: rgba(4, 6, 13, 0.6);
  }

  .side-label {
    font-size: 0.68rem;
    letter-spacing: 0.14em;
    color: var(--color-ink-faint);
    margin-bottom: 0.85rem;
  }

  .capabilities {
    list-style: none;
    display: grid;
    gap: 0.68rem;
  }

  .capabilities li {
    font-family: var(--font-mono);
    font-size: 0.82rem;
    color: var(--color-ink);
    display: flex;
    align-items: center;
    gap: 0.65rem;
    padding: 0.5rem 0.65rem;
    border-radius: var(--radius-sm);
    border: 1px solid var(--color-line-subtle);
    background: rgba(9, 14, 29, 0.72);
  }

  .capabilities li::before {
    content: "▸";
    color: var(--color-cyan);
  }

  @media (max-width: 820px) {
    .about-panel {
      grid-template-columns: 1fr;
    }
  }
</style>
