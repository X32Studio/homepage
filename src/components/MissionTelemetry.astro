---
import type { HeroTelemetry } from "@lib/content";

type Props = {
  telemetry: HeroTelemetry;
};

const { telemetry } = Astro.props;
---

<aside class="arch-panel index-rail" aria-label={telemetry.callsign}>
  <div class="rail-head">
    <span class="rail-title">{telemetry.callsign}</span>
    <span class="rail-sub mono-metric">{telemetry.orbitLabel}</span>
  </div>

  <div class="stack-index">
    <p class="index-label">{telemetry.stackHeading}</p>
    <ul class="layer-list">
      {
        telemetry.layers.map((layer) => (
          <li>
            <a
              class="layer-row"
              href={`#agentic-stack-${layer.id}`}
              data-stack-jump={layer.id}
            >
              <span class="layer-num mono-metric">{layer.code}</span>
              <span class="layer-main">
                <strong>{layer.name}</strong>
                <span class="layer-role">{layer.role}</span>
              </span>
              <span class="layer-tag mono-metric">{layer.tag}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>

  <div class="founder-strip">
    <p class="founder-label">{telemetry.founderLabel}</p>
    <div class="founder-id">
      <strong>{telemetry.founderName}</strong>
      <span class="founder-handle mono-metric">{telemetry.founderHandle}</span>
    </div>
    <p class="founder-title">{telemetry.founderTitle}</p>
    <p class="founder-prev">{telemetry.founderPrevious}</p>
    <div class="founder-links">
      {
        telemetry.links.map((link) => (
          <a href={link.href} target="_blank" rel="noopener noreferrer">
            {link.label} ↗
          </a>
        ))
      }
    </div>
  </div>
</aside>

<script>
  import type { StackLayerId } from "@lib/stack";
  import { requestLayerSelection } from "@lib/stack-selection";

  for (const anchor of document.querySelectorAll<HTMLAnchorElement>("[data-stack-jump]")) {
    anchor.addEventListener("click", () => {
      const layerId = anchor.dataset.stackJump as StackLayerId | undefined;
      if (layerId) {
        requestLayerSelection(layerId);
      }
    });
  }
</script>

<style>
  .index-rail {
    padding: 1.5rem 1.55rem;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    background: rgba(13, 15, 19, 0.84);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
  }

  .rail-head {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding-bottom: 0.95rem;
    border-bottom: 1px solid var(--color-line);
  }

  .rail-title {
    font-size: 0.92rem;
    font-weight: 600;
    color: var(--color-ink);
  }

  .rail-sub {
    font-size: 0.78rem;
    color: var(--color-ink-faint);
  }

  .index-label {
    font-size: 0.82rem;
    font-weight: 500;
    color: var(--color-ink-soft);
    margin-bottom: 0.65rem;
  }

  .layer-list {
    list-style: none;
    display: grid;
    border-top: 1px solid var(--color-line-subtle);
  }

  .layer-row {
    display: grid;
    grid-template-columns: 1.8rem 1fr auto;
    align-items: center;
    gap: 0.75rem;
    padding: 0.72rem 0.55rem;
    border-bottom: 1px solid var(--color-line-subtle);
    transition: background 0.18s var(--ease-out), border-color 0.18s var(--ease-out);
  }

  .layer-row:hover {
    background: rgba(243, 244, 246, 0.04);
    border-bottom-color: var(--color-accent-line);
  }

  .layer-num {
    font-size: 0.78rem;
    color: var(--color-accent);
  }

  .layer-main {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .layer-main strong {
    font-size: 0.92rem;
    font-weight: 600;
    color: var(--color-ink);
    line-height: 1.25;
  }

  .layer-role {
    font-size: 0.8rem;
    color: var(--color-ink-soft);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .layer-tag {
    font-size: 0.74rem;
    color: var(--color-ink-faint);
    white-space: nowrap;
  }

  .founder-strip {
    padding-top: 0.95rem;
    border-top: 1px solid var(--color-line);
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }

  .founder-label {
    font-size: 0.78rem;
    font-weight: 500;
    color: var(--color-ink-faint);
  }

  .founder-id {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin-top: 0.1rem;
  }

  .founder-id strong {
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-ink);
  }

  .founder-handle {
    font-size: 0.76rem;
    color: var(--color-accent);
    padding: 0.14rem 0.5rem;
    border: 1px solid var(--color-accent-line);
    border-radius: var(--radius-sm);
  }

  .founder-title {
    font-size: 0.85rem;
    color: var(--color-ink-soft);
  }

  .founder-prev {
    font-size: 0.8rem;
    color: var(--color-ink-faint);
  }

  .founder-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem 1.05rem;
    margin-top: 0.45rem;
  }

  .founder-links a {
    font-family: var(--font-mono);
    font-size: 0.76rem;
    color: var(--color-ink-soft);
    transition: color 0.18s var(--ease-out);
  }

  .founder-links a:hover {
    color: var(--color-accent);
  }
</style>
