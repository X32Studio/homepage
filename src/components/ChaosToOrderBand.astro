---
import type { Locale } from "@lib/content";

type Props = {
  locale: Locale;
};

const { locale } = Astro.props;
const isZh = locale === "zh";

const copy = isZh
  ? {
      index: "01 · 工程治理前提",
      heading: "算力廉价。人最稀缺的瓶颈是 Attention。",
      subtitle: "没有代码门禁与角色分离的多 Agent 协作只会放大返工；X32 Studio 用可验证的工程治理将零散 Agent 群落整编为可信交付组织。",
      chaosTag: "无治理的 Agent 群落",
      chaosMeta: "结构性失效模式",
      chaosRows: [
        { code: "01", label: "自写自测", detail: "同一个模型既改业务代码又改测试断言，悄无声息糊弄绿灯。", state: "伪通过" },
        { code: "02", label: "前提漂移", detail: "在错误架构假设上连续打补丁，复杂度失控且无人叫停。", state: "死循环" },
        { code: "03", label: "注意力耗尽", detail: "人类被迫全程盯盘救火，吞噬战略与系统架构时间。", state: "高损耗" },
      ],
      orderTag: "self-loop 治理架构",
      orderMeta: "可验证的 Agent 交付组织",
      orderRows: [
        { code: "01", label: "三引擎解耦调度", detail: "规划契约、依赖图并行 Actor 波次与跨厂商 Critic / Judge 独立验收严格分离。", state: "权责隔离" },
        { code: "02", label: "代码级硬门禁", detail: "前提审计 exit 7、SSOT 权威文档漂移检查、防腐扫描与精确 commit 远端 CI 回执。", state: "机械验证" },
        { code: "03", label: "低介入战略拍板", detail: "常规执行与对抗硬化自主收敛，仅将关键方向决策打包交给人类 DRI。", state: "高杠杆" },
      ],
      axiom: "代码门禁高于提示词服从——能否把 Agent 群落整编成可信组织，决定 AI 时代人的能力上限。",
    }
  : {
      index: "01 · Engineering Premise",
      heading: "Compute is cheap. Human attention is the bottleneck.",
      subtitle: "Unmanaged coding agents amplify rework. X32 Studio enforces role separation and executable gates so autonomous teams ship verified software.",
      chaosTag: "Unmanaged agent swarms",
      chaosMeta: "Structural failure modes",
      chaosRows: [
        { code: "01", label: "Self-grading checks", detail: "One model edits implementation and weakens its own tests to claim a green build.", state: "Unverified" },
        { code: "02", label: "Premise drift", detail: "Agents stack patch after patch on top of a broken architectural assumption.", state: "Stalled" },
        { code: "03", label: "Attention drain", detail: "Engineers spend hours supervising terminals instead of owning system strategy.", state: "Depleted" },
      ],
      orderTag: "Governed self-loop architecture",
      orderMeta: "Verifiable agent delivery organization",
      orderRows: [
        { code: "01", label: "Decoupled three-engine flow", detail: "Contract planning, dependency-aware parallel Actor waves, and cross-vendor Critic / Judge verification.", state: "Separated" },
        { code: "02", label: "Executable hard gates", detail: "Premise audit exit 7, SSOT drift checks, anti-rot scanning, and exact-commit remote CI receipts.", state: "Enforced" },
        { code: "03", label: "Batched strategic decisions", detail: "Execution and adversarial hardening converge autonomously while only material choices surface to the DRI.", state: "Leveraged" },
      ],
      axiom: "Code gates replace prompt obedience: how you govern your agent organization determines how much verified software one engineer can ship.",
    };
---

<section class="section contrast-section" aria-label={copy.heading}>
  <div class="container">
    <div class="contrast-head reveal">
      <span class="section-index">{copy.index}</span>
      <h2>{copy.heading}</h2>
      <p class="contrast-sub">{copy.subtitle}</p>
    </div>

    <div class="contrast-grid reveal" data-delay="1">
      <article class="arch-panel contrast-panel is-baseline">
        <div class="panel-bar">
          <div>
            <h3>{copy.chaosTag}</h3>
            <p class="panel-meta">{copy.chaosMeta}</p>
          </div>
        </div>
        <ul class="signal-rows">
          {
            copy.chaosRows.map((row) => (
              <li>
                <span class="row-code mono-metric">{row.code}</span>
                <div class="row-main">
                  <strong>{row.label}</strong>
                  <p>{row.detail}</p>
                </div>
                <span class="row-state is-muted mono-metric">{row.state}</span>
              </li>
            ))
          }
        </ul>
      </article>

      <article class="arch-panel contrast-panel is-governed">
        <div class="panel-bar">
          <div>
            <h3>{copy.orderTag}</h3>
            <p class="panel-meta">{copy.orderMeta}</p>
          </div>
        </div>
        <ul class="signal-rows">
          {
            copy.orderRows.map((row) => (
              <li>
                <span class="row-code mono-metric">{row.code}</span>
                <div class="row-main">
                  <strong>{row.label}</strong>
                  <p>{row.detail}</p>
                </div>
                <span class="row-state is-accent mono-metric">{row.state}</span>
              </li>
            ))
          }
        </ul>
      </article>
    </div>

    <p class="axiom-strip reveal" data-delay="2">{copy.axiom}</p>
  </div>
</section>

<style>
  .contrast-head {
    margin-bottom: clamp(2rem, 4.5vw, 3rem);
  }

  .contrast-head h2 {
    font-size: clamp(1.9rem, 3.6vw, 2.85rem);
    max-width: 24ch;
  }

  .contrast-sub {
    margin-top: 0.9rem;
    max-width: 60ch;
    color: var(--color-ink-soft);
    font-size: 1rem;
  }

  .contrast-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.5rem;
  }

  .contrast-panel {
    overflow: hidden;
  }

  .contrast-panel.is-baseline {
    background: var(--color-bg-raised);
  }

  .contrast-panel.is-governed {
    border-color: var(--color-accent-line);
    background: var(--color-panel);
  }

  .panel-bar {
    padding: 1.2rem 1.4rem;
    border-bottom: 1px solid var(--color-line);
  }

  .panel-bar h3 {
    font-size: 1.12rem;
    font-weight: 600;
  }

  .is-governed .panel-bar h3 {
    color: var(--color-accent);
  }

  .panel-meta {
    margin-top: 0.2rem;
    font-size: 0.84rem;
    color: var(--color-ink-faint);
  }

  .signal-rows {
    list-style: none;
    display: grid;
  }

  .signal-rows li {
    display: grid;
    grid-template-columns: 2rem 1fr auto;
    align-items: start;
    gap: 0.95rem;
    padding: 1.15rem 1.4rem;
    border-bottom: 1px solid var(--color-line-subtle);
  }

  .signal-rows li:last-child {
    border-bottom: 0;
  }

  .row-code {
    font-size: 0.78rem;
    color: var(--color-ink-faint);
    padding-top: 0.16rem;
  }

  .row-main strong {
    display: block;
    font-size: 0.98rem;
    font-weight: 600;
    color: var(--color-ink);
  }

  .row-main p {
    font-size: 0.9rem;
    color: var(--color-ink-soft);
    margin-top: 0.25rem;
    line-height: 1.52;
  }

  .row-state {
    font-size: 0.74rem;
    padding: 0.2rem 0.56rem;
    border-radius: var(--radius-sm);
    border: 1px solid var(--color-line);
    white-space: nowrap;
  }

  .row-state.is-muted {
    color: var(--color-ink-faint);
  }

  .row-state.is-accent {
    color: var(--color-accent);
    border-color: var(--color-accent-line);
    background: var(--color-accent-soft);
  }

  .axiom-strip {
    margin-top: 1.5rem;
    padding: 1.1rem 1.4rem;
    border-left: 2px solid var(--color-accent);
    border-top: 1px solid var(--color-line-subtle);
    border-bottom: 1px solid var(--color-line-subtle);
    background: var(--color-bg-raised);
    font-size: 0.94rem;
    color: var(--color-ink);
  }

  @media (max-width: 860px) {
    .contrast-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 520px) {
    .signal-rows li {
      grid-template-columns: 1fr;
      gap: 0.45rem;
    }

    .row-state {
      justify-self: start;
    }
  }
</style>
