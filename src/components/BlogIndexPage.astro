---
import BaseLayout from "@layouts/BaseLayout.astro";
import { formatPostDate, getAlternateLocalePath, getSiteContent, type Locale } from "@lib/content";
import { getCollection } from "astro:content";

type Props = {
  locale: Locale;
};

const { locale } = Astro.props;
const content = getSiteContent(locale);
const alternatePath = getAlternateLocalePath(locale, Astro.url.pathname);

const posts = (await getCollection("blog", ({ data }) => !data.draft && data.locale === locale)).sort(
  (left, right) => right.data.pubDate.valueOf() - left.data.pubDate.valueOf(),
);

const pageTitle = locale === "zh" ? "博客" : "Blog";
const blogBase = locale === "zh" ? "/zh/blog/" : "/blog/";
const langTag = locale === "zh" ? "中文" : "EN";
---

<BaseLayout content={content} locale={locale} alternatePath={alternatePath} title={pageTitle}>
  <section class="section">
    <div class="container">
      <p class="eyebrow reveal">{content.blogIntro.eyebrow}</p>
      <h1 class="page-title reveal" data-delay="1">{content.blogIntro.title}</h1>
      <div class="post-list reveal" data-delay="2">
        {
          posts.map((post) => (
            <article class="post-row">
              <time datetime={post.data.pubDate.toISOString()}>{formatPostDate(post.data.pubDate)}</time>
              <div>
                <h3>
                  <a href={`${blogBase}${post.data.postSlug}/`}>{post.data.title}</a>
                </h3>
                <p>{post.data.description}</p>
                {post.data.tags.length > 0 && (
                  <div class="post-tags">
                    {post.data.tags.map((tag) => (
                      <span class="mono-metric">#{tag}</span>
                    ))}
                  </div>
                )}
              </div>
              <span class="lang-tag">{langTag}</span>
            </article>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .page-title {
    font-size: clamp(2.1rem, 5vw, 3.5rem);
    margin-top: 0.85rem;
  }

  .post-list {
    margin-top: clamp(2rem, 5vw, 3.1rem);
    border-top: 1px solid var(--color-line);
  }

  .post-list p {
    color: var(--color-ink-soft);
    font-size: 0.92rem;
    margin-top: 0.25rem;
    max-width: 62ch;
  }

  .post-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
    margin-top: 0.45rem;
  }

  .post-tags span {
    font-size: 0.7rem;
    color: #c4b5fd;
  }
</style>
