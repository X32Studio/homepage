---
import type { Locale } from "@lib/content";

type Props = {
  locale: Locale;
  alternatePath: string;
};

const { locale, alternatePath } = Astro.props;
const label = locale === "en" ? "中文" : "EN";
---

<a class="language-switch" href={alternatePath} aria-label="Switch language">
  {label}
</a>
