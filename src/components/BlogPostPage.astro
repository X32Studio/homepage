---
import BaseLayout from "@layouts/BaseLayout.astro";
import { getSiteContent } from "@lib/content";
import { render, type CollectionEntry } from "astro:content";

type Props = {
  post: CollectionEntry<"blog">;
  locale: "en" | "zh";
};

const { post, locale } = Astro.props;
const { Content } = await render(post);
const content = getSiteContent(locale);
---

<BaseLayout
  content={content}
  locale={locale}
  alternatePath={locale === "en" ? `/zh/blog/${Astro.params.slug}/` : `/blog/${Astro.params.slug}/`}
  title={post.data.title}
  description={post.data.description}
>
  <article class="section">
    <div class="container narrow">
      <p class="eyebrow rise">
        <time datetime={post.data.pubDate.toISOString()}>{post.data.pubDate.toISOString().slice(0, 10)}</time>
        · X32 Studio
      </p>
      <h1 class="rise d1">{post.data.title}</h1>
      <div class="prose rise d2">
        <Content />
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  .narrow {
    max-width: 46rem;
  }

  h1 {
    font-size: clamp(2rem, 5vw, 3.2rem);
    margin-top: 1.1rem;
  }

  .prose {
    margin-top: 2.4rem;
    font-size: 1.05rem;
    color: var(--color-ink-soft);
  }

  .prose :global(h2) {
    color: var(--color-ink);
    font-size: 1.6rem;
    margin-block: 2.2rem 0.9rem;
  }

  .prose :global(h3) {
    color: var(--color-ink);
    font-size: 1.25rem;
    margin-block: 1.8rem 0.7rem;
  }

  .prose :global(p) {
    margin-block: 1rem;
  }

  .prose :global(strong),
  .prose :global(a) {
    color: var(--color-ink);
  }

  .prose :global(a:hover) {
    color: var(--color-cyan);
  }

  .prose :global(ol),
  .prose :global(ul) {
    padding-left: 1.4rem;
    margin-block: 1rem;
    display: grid;
    gap: 0.45rem;
  }

  .prose :global(code) {
    font-family: var(--font-mono);
    font-size: 0.88em;
    background: rgba(110, 231, 255, 0.08);
    border-radius: 0.35rem;
    padding: 0.12em 0.4em;
    color: var(--color-cyan);
  }

  .prose :global(pre) {
    background: var(--color-bg-raised);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-md);
    padding: 1.2rem;
    overflow-x: auto;
    margin-block: 1.3rem;
  }

  .prose :global(pre code) {
    background: none;
    padding: 0;
    color: inherit;
  }
</style>
