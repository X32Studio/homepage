---
import BaseLayout from "@layouts/BaseLayout.astro";
import { getSiteContent } from "@lib/content";
import { render, type CollectionEntry } from "astro:content";

type Props = {
  post: CollectionEntry<"blog">;
  locale: "en" | "zh";
};

const { post, locale } = Astro.props;
const { Content } = await render(post);
const content = getSiteContent(locale);
---

<BaseLayout
  content={content}
  locale={locale}
  alternatePath={locale === "en" ? `/zh/blog/${Astro.params.slug}/` : `/blog/${Astro.params.slug}/`}
  title={post.data.title}
  description={post.data.description}
>
  <article class="section">
    <div class="container narrow">
      <p class="section-index rise">
        <time datetime={post.data.pubDate.toISOString()}>{post.data.pubDate.toISOString().slice(0, 10)}</time>
        · X32 Studio
      </p>
      <h1 class="rise d1">{post.data.title}</h1>
      <div class="prose rise d2">
        <Content />
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  .narrow {
    max-width: 46rem;
  }

  h1 {
    font-size: clamp(2.05rem, 5vw, 3.25rem);
  }

  .prose {
    margin-top: 2.6rem;
    font-size: 1.05rem;
    line-height: 1.75;
    color: var(--color-ink-soft);
  }

  .prose :global(h2) {
    color: var(--color-ink);
    font-size: 1.6rem;
    margin-block: 2.4rem 0.9rem;
  }

  .prose :global(h3) {
    color: var(--color-ink);
    font-size: 1.25rem;
    margin-block: 1.9rem 0.7rem;
  }

  .prose :global(p) {
    margin-block: 1.05rem;
  }

  .prose :global(strong),
  .prose :global(a) {
    color: var(--color-ink);
  }

  .prose :global(a) {
    border-bottom: 1px solid var(--color-line-bright);
    transition: color 0.18s var(--ease-out), border-color 0.18s var(--ease-out);
  }

  .prose :global(a:hover) {
    color: var(--color-accent);
    border-bottom-color: var(--color-accent);
  }

  .prose :global(ol),
  .prose :global(ul) {
    padding-left: 1.4rem;
    margin-block: 1rem;
    display: grid;
    gap: 0.48rem;
  }

  .prose :global(code) {
    font-family: var(--font-mono);
    font-size: 0.87em;
    background: var(--color-bg-raised);
    border: 1px solid var(--color-line-subtle);
    border-radius: var(--radius-sm);
    padding: 0.1em 0.4em;
    color: var(--color-accent);
  }

  .prose :global(pre) {
    background: var(--color-bg-raised);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-md);
    padding: 1.25rem;
    overflow-x: auto;
    margin-block: 1.4rem;
  }

  .prose :global(pre code) {
    background: none;
    border: 0;
    padding: 0;
    color: var(--color-ink);
  }
</style>
