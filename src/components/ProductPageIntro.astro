---
import type { Product, SiteContent } from "@lib/content";

type Props = {
  content: SiteContent;
  products: Product[];
};

const { content, products } = Astro.props;
---

<section class="product-intro">
  <p class="label">{content.labsIntro.eyebrow}</p>
  <h1>{content.labsIntro.title}</h1>
  <p>{content.labsIntro.body}</p>
  <div class="product-toc">
    {products.map((product) => <a href={`#${product.id}`}>{product.name}</a>)}
  </div>
</section>

<style>
  .product-intro {
    display: grid;
    gap: 1rem;
    padding: clamp(4rem, 8vw, 7rem) 0 clamp(2rem, 5vw, 4rem);
  }

  h1 {
    font-family: var(--font-display);
    font-size: clamp(3rem, 8vw, 7rem);
    font-weight: 500;
    letter-spacing: -0.07em;
    line-height: 0.88;
    margin: 0;
    max-width: 12ch;
  }

  p:not(.label) {
    color: var(--color-ink-soft);
    font-size: clamp(1.1rem, 1.8vw, 1.35rem);
    line-height: 1.55;
    max-width: 43rem;
  }

  .product-toc {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1rem;
  }

  .product-toc a {
    border: 1px solid var(--color-line);
    border-radius: 999px;
    font-weight: 800;
    padding: 0.68rem 0.9rem;
  }
</style>
