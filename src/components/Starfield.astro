---
---

<canvas id="starfield" aria-hidden="true"></canvas>

<style>
  #starfield {
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }
</style>

<script>
  const element = document.getElementById("starfield") as HTMLCanvasElement | null;

  if (element) {
    const canvas: HTMLCanvasElement = element;
    const ctx = canvas.getContext("2d");
    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    let width = 0;
    let height = 0;
    let stars: { x: number; y: number; r: number; depth: number; phase: number }[] = [];
    let meteors: { x: number; y: number; vx: number; vy: number; life: number }[] = [];
    let scrollY = window.scrollY;

    function seed() {
      const count = Math.min(220, Math.floor((width * height) / 6500));
      stars = Array.from({ length: count }, () => ({
        x: Math.random() * width,
        y: Math.random() * height,
        r: Math.random() * 1.3 + 0.3,
        depth: Math.random(),
        phase: Math.random() * Math.PI * 2,
      }));
    }

    function resize() {
      width = canvas.width = window.innerWidth * devicePixelRatio;
      height = canvas.height = window.innerHeight * devicePixelRatio;
      canvas.style.width = `${window.innerWidth}px`;
      canvas.style.height = `${window.innerHeight}px`;
      seed();
      if (reducedMotion) draw(0);
    }

    function spawnMeteor() {
      if (!reducedMotion && Math.random() < 0.006 && meteors.length < 2) {
        meteors.push({
          x: Math.random() * width * 0.8 + width * 0.1,
          y: Math.random() * height * 0.3,
          vx: -(4 + Math.random() * 4) * devicePixelRatio,
          vy: (2 + Math.random() * 2) * devicePixelRatio,
          life: 1,
        });
      }
    }

    function draw(t: number) {
      if (!ctx) return;
      ctx.clearRect(0, 0, width, height);

      for (const star of stars) {
        const twinkle = 0.55 + 0.45 * Math.sin(t * 0.0012 + star.phase);
        const parallax = scrollY * 0.06 * star.depth * devicePixelRatio;
        const y = (((star.y - parallax) % height) + height) % height;
        ctx.globalAlpha = (0.25 + star.depth * 0.65) * twinkle;
        ctx.fillStyle = star.depth > 0.85 ? "#a78bfa" : star.depth > 0.6 ? "#6ee7ff" : "#eef0ff";
        ctx.beginPath();
        ctx.arc(star.x, y, star.r * devicePixelRatio, 0, Math.PI * 2);
        ctx.fill();
      }

      spawnMeteor();
      for (const meteor of meteors) {
        meteor.x += meteor.vx;
        meteor.y += meteor.vy;
        meteor.life -= 0.02;
        const gradient = ctx.createLinearGradient(
          meteor.x,
          meteor.y,
          meteor.x - meteor.vx * 12,
          meteor.y - meteor.vy * 12,
        );
        gradient.addColorStop(0, `rgba(238, 240, 255, ${Math.max(meteor.life, 0)})`);
        gradient.addColorStop(1, "rgba(238, 240, 255, 0)");
        ctx.globalAlpha = 1;
        ctx.strokeStyle = gradient;
        ctx.lineWidth = 1.4 * devicePixelRatio;
        ctx.beginPath();
        ctx.moveTo(meteor.x, meteor.y);
        ctx.lineTo(meteor.x - meteor.vx * 12, meteor.y - meteor.vy * 12);
        ctx.stroke();
      }
      meteors = meteors.filter((meteor) => meteor.life > 0);

      ctx.globalAlpha = 1;
      if (!reducedMotion) requestAnimationFrame(draw);
    }

    window.addEventListener("resize", resize);
    window.addEventListener(
      "scroll",
      () => {
        scrollY = window.scrollY;
      },
      { passive: true },
    );
    resize();

    if (reducedMotion) {
      draw(0);
    } else {
      requestAnimationFrame(draw);
    }
  }
</script>
