---
---

<canvas id="starfield" aria-hidden="true"></canvas>

<style>
  #starfield {
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }
</style>

<script>
  const element = document.getElementById("starfield") as HTMLCanvasElement | null;

  if (element) {
    const canvas: HTMLCanvasElement = element;
    const ctx = canvas.getContext("2d");
    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    type Star = {
      x: number;
      y: number;
      r: number;
      layer: 0 | 1 | 2;
      phase: number;
      tint: string;
    };

    const layerSpeeds = [0.025, 0.055, 0.1];
    const layerPointer = [4, 10, 18];

    let width = 0;
    let height = 0;
    let dpr = 1;
    let stars: Star[] = [];
    let scrollY = window.scrollY;
    let pointerTargetX = 0;
    let pointerTargetY = 0;
    let pointerX = 0;
    let pointerY = 0;
    let rafId: number | null = null;

    function seed() {
      const area = (width / dpr) * (height / dpr);
      const count = Math.min(240, Math.max(90, Math.floor(area / 6200)));
      stars = Array.from({ length: count }, (_, idx) => {
        const mod = idx % 10;
        const layer: 0 | 1 | 2 = mod < 5 ? 0 : mod < 8 ? 1 : 2;
        const tint =
          layer === 2
            ? Math.random() > 0.45
              ? "#6ee7ff"
              : "#8b7cf8"
            : layer === 1
              ? Math.random() > 0.72
                ? "#9cefff"
                : "#dbe5ff"
              : "#8fa2cc";
        const baseRadius = layer === 0 ? 0.55 : layer === 1 ? 0.9 : 1.35;
        return {
          x: Math.random() * width,
          y: Math.random() * height,
          r: baseRadius + Math.random() * 0.55,
          layer,
          phase: Math.random() * Math.PI * 2,
          tint,
        };
      });
    }

    function drawOrbitalBackdrop(t: number) {
      if (!ctx) return;
      const cx = width * 0.8 + pointerX * 18 * dpr;
      const cy = height * 0.24 + pointerY * 12 * dpr - scrollY * 0.05 * dpr;
      const baseR = Math.min(width, height) * 0.4;
      const angle = reducedMotion ? 0.5 : t * 0.00009;

      ctx.save();
      ctx.translate(cx, cy);

      // Precision crosshair axes
      ctx.strokeStyle = "rgba(0, 240, 255, 0.12)";
      ctx.lineWidth = 1 * dpr;
      ctx.beginPath();
      ctx.moveTo(-baseR * 1.18, 0);
      ctx.lineTo(baseR * 1.18, 0);
      ctx.moveTo(0, -baseR * 1.18);
      ctx.lineTo(0, baseR * 1.18);
      ctx.stroke();

      // Rotating radar sweep wedge
      const sweepGrad = ctx.createRadialGradient(0, 0, baseR * 0.08, 0, 0, baseR);
      sweepGrad.addColorStop(0, "rgba(0, 240, 255, 0.16)");
      sweepGrad.addColorStop(0.6, "rgba(0, 240, 255, 0.05)");
      sweepGrad.addColorStop(1, "rgba(0, 240, 255, 0)");
      ctx.fillStyle = sweepGrad;
      ctx.beginPath();
      ctx.moveTo(0, 0);
      ctx.arc(0, 0, baseR, angle - 0.35, angle);
      ctx.closePath();
      ctx.fill();

      // Outer dashed telemetry ring
      ctx.strokeStyle = "rgba(0, 240, 255, 0.24)";
      ctx.lineWidth = 1.2 * dpr;
      ctx.setLineDash([4 * dpr, 8 * dpr]);
      ctx.beginPath();
      ctx.arc(0, 0, baseR, 0, Math.PI * 2);
      ctx.stroke();

      // Primary bright orbital arc
      ctx.setLineDash([]);
      ctx.strokeStyle = "rgba(0, 240, 255, 0.46)";
      ctx.lineWidth = 1.8 * dpr;
      ctx.beginPath();
      ctx.arc(0, 0, baseR * 0.72, angle, angle + Math.PI * 0.74);
      ctx.stroke();

      // Secondary counter-rotating ember tactical arc
      ctx.strokeStyle = "rgba(255, 77, 0, 0.42)";
      ctx.lineWidth = 1.5 * dpr;
      ctx.beginPath();
      ctx.arc(0, 0, baseR * 0.48, -angle * 1.45 + 1.0, -angle * 1.45 + 2.55);
      ctx.stroke();

      // Polar tick marks around outer ring
      ctx.strokeStyle = "rgba(0, 240, 255, 0.32)";
      ctx.lineWidth = 1.1 * dpr;
      for (let i = 0; i < 36; i += 1) {
        const theta = (i / 36) * Math.PI * 2 + angle * 0.2;
        const inner = baseR * (i % 9 === 0 ? 0.91 : 0.965);
        ctx.beginPath();
        ctx.moveTo(Math.cos(theta) * inner, Math.sin(theta) * inner);
        ctx.lineTo(Math.cos(theta) * baseR, Math.sin(theta) * baseR);
        ctx.stroke();
      }

      // Active orbital satellite node + halo
      const satX = Math.cos(angle + Math.PI * 0.74) * baseR * 0.72;
      const satY = Math.sin(angle + Math.PI * 0.74) * baseR * 0.72;
      ctx.fillStyle = "rgba(0, 240, 255, 0.22)";
      ctx.beginPath();
      ctx.arc(satX, satY, 9 * dpr, 0, Math.PI * 2);
      ctx.fill();
      ctx.fillStyle = "#00f0ff";
      ctx.beginPath();
      ctx.arc(satX, satY, 2.8 * dpr, 0, Math.PI * 2);
      ctx.fill();

      ctx.restore();
    }

    function drawFrame(t: number) {
      if (!ctx) return;
      ctx.clearRect(0, 0, width, height);

      if (!reducedMotion) {
        pointerX += (pointerTargetX - pointerX) * 0.05;
        pointerY += (pointerTargetY - pointerY) * 0.05;
      }

      drawOrbitalBackdrop(t);

      for (const star of stars) {
        const twinkle = reducedMotion ? 0.82 : 0.58 + 0.42 * Math.sin(t * 0.001 + star.phase);
        const px = pointerX * layerPointer[star.layer] * dpr;
        const py = pointerY * layerPointer[star.layer] * dpr;
        const scrollShift = scrollY * layerSpeeds[star.layer] * dpr;

        const x = (((star.x + px) % width) + width) % width;
        const y = (((star.y + py - scrollShift) % height) + height) % height;

        const baseAlpha = star.layer === 0 ? 0.28 : star.layer === 1 ? 0.52 : 0.8;
        ctx.globalAlpha = baseAlpha * twinkle;
        ctx.fillStyle = star.tint;
        ctx.beginPath();
        ctx.arc(x, y, star.r * dpr, 0, Math.PI * 2);
        ctx.fill();
      }

      ctx.globalAlpha = 1;
    }

    function loop(t: number) {
      if (document.hidden || reducedMotion) {
        rafId = null;
        return;
      }
      drawFrame(t);
      rafId = requestAnimationFrame(loop);
    }

    function start() {
      if (reducedMotion) {
        drawFrame(0);
        return;
      }
      if (rafId === null && !document.hidden) {
        rafId = requestAnimationFrame(loop);
      }
    }

    function stop() {
      if (rafId !== null) {
        cancelAnimationFrame(rafId);
        rafId = null;
      }
    }

    function resize() {
      dpr = Math.min(window.devicePixelRatio || 1, 2);
      width = canvas.width = Math.floor(window.innerWidth * dpr);
      height = canvas.height = Math.floor(window.innerHeight * dpr);
      canvas.style.width = `${window.innerWidth}px`;
      canvas.style.height = `${window.innerHeight}px`;
      seed();
      drawFrame(0);
    }

    window.addEventListener("resize", resize);
    window.addEventListener(
      "scroll",
      () => {
        scrollY = window.scrollY;
        if (reducedMotion) drawFrame(0);
      },
      { passive: true },
    );

    if (!reducedMotion) {
      window.addEventListener(
        "pointermove",
        (event) => {
          pointerTargetX = event.clientX / Math.max(window.innerWidth, 1) - 0.5;
          pointerTargetY = event.clientY / Math.max(window.innerHeight, 1) - 0.5;
        },
        { passive: true },
      );
    }

    document.addEventListener("visibilitychange", () => {
      if (document.hidden) {
        stop();
      } else {
        start();
      }
    });

    resize();
    start();
  }
</script>
