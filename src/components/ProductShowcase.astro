---
import type { Product } from "@lib/content";

type Props = {
  products: Product[];
};

const { products } = Astro.props;
---

<section class="product-showcase">
  {
    products.map((product, index) => (
      <article id={product.id} class="showcase-item">
        <div class="showcase-number">{String(index + 1).padStart(2, "0")}</div>
        <div class="showcase-copy">
          <p class="label">{product.status}</p>
          <h2>{product.name}</h2>
          <p>{product.summary}</p>
        </div>
        <aside>
          <strong>{product.audience}</strong>
          <ul>
            {product.tags.map((tag) => (
              <li>{tag}</li>
            ))}
          </ul>
          {product.links.map((link) => (
            <a href={link.href}>{link.label}</a>
          ))}
        </aside>
      </article>
    ))
  }
</section>

<style>
  .product-showcase {
    border-top: 1px solid var(--color-line);
  }

  .showcase-item {
    border-bottom: 1px solid var(--color-line);
    display: grid;
    gap: clamp(1.5rem, 4vw, 3rem);
    grid-template-columns: 4rem minmax(0, 1.1fr) minmax(14rem, 0.55fr);
    padding: clamp(2rem, 5vw, 4rem) 0;
  }

  .showcase-number {
    color: var(--color-accent);
    font-family: var(--font-display);
    font-size: 2.5rem;
  }

  h2 {
    font-family: var(--font-display);
    font-size: clamp(3rem, 7vw, 6rem);
    font-weight: 500;
    letter-spacing: -0.07em;
    line-height: 0.88;
    margin: 0.3rem 0 1rem;
  }

  .showcase-copy p:not(.label),
  aside {
    color: var(--color-ink-soft);
    line-height: 1.6;
  }

  aside {
    display: grid;
    gap: 1rem;
  }

  aside strong {
    color: var(--color-ink);
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  li,
  aside a {
    border: 1px solid var(--color-line);
    border-radius: 999px;
    padding: 0.35rem 0.58rem;
  }

  aside a {
    color: var(--color-ink);
    font-weight: 800;
    justify-self: start;
  }

  @media (max-width: 820px) {
    .showcase-item {
      grid-template-columns: 1fr;
    }
  }
</style>
