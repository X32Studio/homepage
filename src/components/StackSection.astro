---
import AgenticStack from "@components/AgenticStack";
import type { Locale } from "@lib/content";
import { getStackCopy, getStackLayers } from "@lib/stack";

type Props = {
  locale: Locale;
};

const { locale } = Astro.props;
const copy = getStackCopy(locale);
const layers = getStackLayers(locale);
---

<section class="section stack-section" id="agentic-stack">
  {
    layers.map((layer) => (
      <span id={`agentic-stack-${layer.id}`} class="stack-anchor" aria-hidden="true" />
    ))
  }
  <div class="container">
    <div class="section-head reveal">
      <div>
        <p class="eyebrow">{copy.eyebrow}</p>
        <h2>{copy.title}</h2>
        <p class="stack-lede">{copy.subtitle}</p>
      </div>
      <a class="more" href={copy.allProjectsHref}>{copy.allProjectsLabel}</a>
    </div>

    <div class="reveal" data-delay="1">
      <AgenticStack client:visible copy={copy} layers={layers} />
    </div>
  </div>
</section>

<style>
  .stack-section {
    position: relative;
  }

  .stack-anchor {
    position: absolute;
    top: 0;
    left: 0;
    width: 1px;
    height: 1px;
    pointer-events: none;
    scroll-margin-top: 5rem;
  }

  .stack-lede {
    color: var(--color-ink-soft);
    max-width: 62ch;
    margin-top: 0.8rem;
    font-size: 0.98rem;
  }
</style>

<style is:global>
  .stack-explorer {
    display: grid;
    grid-template-columns: minmax(0, 0.92fr) minmax(0, 1.28fr);
    gap: clamp(1.25rem, 3vw, 2rem);
    align-items: start;
  }

  .stack-topology {
    display: grid;
    grid-template-columns: 3.6rem minmax(0, 1fr);
    gap: 0.7rem;
    align-items: stretch;
  }

  .bus-rail {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding-top: 0.2rem;
  }

  .bus-svg {
    width: 3.5rem;
    height: 22.25rem;
  }

  .bus-caption {
    margin-top: 0.4rem;
    font-size: 0.62rem;
    letter-spacing: 0.08em;
    color: #c4b5fd;
    text-align: center;
    line-height: 1.3;
  }

  .stack-tabs {
    display: grid;
    gap: 0.72rem;
  }

  .stack-tab {
    text-align: left;
    display: flex;
    flex-direction: column;
    gap: 0.22rem;
    min-height: 5.05rem;
    padding: 0.9rem 1.05rem;
    border-radius: var(--radius-sm);
    border: 1px solid var(--color-line-subtle);
    border-left: 2px solid rgba(0, 240, 255, 0.24);
    background: rgba(5, 8, 14, 0.9);
    transition:
      border-color 0.18s var(--ease-out),
      background 0.18s var(--ease-out),
      transform 0.18s var(--ease-out);
  }

  .stack-tab:hover {
    border-color: var(--color-line-bright);
    background: rgba(10, 16, 28, 0.96);
  }

  .stack-tab.is-linked {
    border-color: rgba(255, 77, 0, 0.36);
  }

  .stack-tab.is-active {
    border-color: var(--color-cyan);
    border-left: 4px solid var(--color-cyan);
    background: linear-gradient(120deg, rgba(0, 240, 255, 0.16), rgba(7, 10, 16, 0.98) 64%);
    box-shadow: 0 0 30px rgba(0, 240, 255, 0.18);
    transform: translateX(4px);
  }

  .tab-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.6rem;
  }

  .tab-code {
    font-size: 0.74rem;
    font-weight: 600;
    color: var(--color-cyan);
  }

  .tab-badge {
    font-size: 0.66rem;
    letter-spacing: 0.08em;
    color: var(--color-ink-faint);
  }

  .stack-tab.is-active .tab-badge {
    color: #c4b5fd;
  }

  .tab-name {
    font-family: var(--font-display);
    font-size: 1.08rem;
    font-weight: 600;
    color: var(--color-ink);
  }

  .tab-role {
    font-size: 0.8rem;
    color: var(--color-ink-soft);
  }

  .stack-inspector {
    padding: clamp(1.25rem, 3vw, 1.85rem);
    display: flex;
    flex-direction: column;
    gap: 1.2rem;
    min-width: 0;
  }

  .inspector-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.65rem;
  }

  .inspector-role {
    font-size: 0.74rem;
    color: var(--color-ink-faint);
    letter-spacing: 0.06em;
  }

  .inspector-head h3 {
    font-size: clamp(1.5rem, 2.8vw, 2rem);
    margin-top: 0.65rem;
  }

  .inspector-oneliner {
    margin-top: 0.45rem;
    font-size: 1rem;
    color: var(--color-ink);
    font-weight: 500;
  }

  .inspector-desc {
    margin-top: 0.45rem;
    font-size: 0.92rem;
    color: var(--color-ink-soft);
  }

  .io-grid {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: 0.75rem;
    align-items: center;
    padding: 0.85rem 0.95rem;
    border-radius: var(--radius-md);
    border: 1px solid var(--color-line-subtle);
    background: rgba(4, 6, 13, 0.56);
  }

  .io-label {
    display: block;
    font-size: 0.65rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-cyan);
    margin-bottom: 0.2rem;
  }

  .io-cell p {
    font-size: 0.83rem;
    color: var(--color-ink-soft);
    line-height: 1.45;
  }

  .io-arrow {
    color: var(--color-violet);
    font-size: 1.05rem;
  }

  .command-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin-bottom: 0.4rem;
    font-size: 0.68rem;
    letter-spacing: 0.14em;
    color: var(--color-ink-faint);
  }

  .copy-btn {
    border: 1px solid var(--color-line-bright);
    background: rgba(110, 231, 255, 0.08);
    color: var(--color-cyan);
    border-radius: var(--radius-sm);
    padding: 0.22rem 0.62rem;
    font-size: 0.7rem;
    min-height: 1.75rem;
    transition: background 0.2s var(--ease-out), border-color 0.2s var(--ease-out);
  }

  .copy-btn:hover {
    background: rgba(110, 231, 255, 0.18);
    border-color: var(--color-cyan);
  }

  .copy-btn.is-copied {
    border-color: var(--color-emerald);
    background: rgba(52, 211, 153, 0.14);
    color: var(--color-emerald);
  }

  .copy-btn.is-failed {
    border-color: var(--color-ember);
    background: rgba(251, 146, 60, 0.14);
    color: var(--color-ember);
  }

  .cmd-prompt {
    color: var(--color-ink-faint);
    user-select: none;
    margin-right: 0.45rem;
  }

  .cmd-block code {
    user-select: all;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .instrument-figure {
    border-radius: var(--radius-md);
    overflow: hidden;
    border: 1px solid var(--color-line);
    background: rgba(4, 6, 13, 0.72);
  }

  .instrument-figure img {
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }

  .instrument-figure figcaption {
    padding: 0.55rem 0.85rem;
    font-size: 0.69rem;
    letter-spacing: 0.08em;
    color: var(--color-ink-soft);
    border-top: 1px solid var(--color-line-subtle);
  }

  .telemetry-matrix {
    border-radius: var(--radius-md);
    border: 1px solid var(--color-line-subtle);
    background: rgba(4, 6, 13, 0.62);
    padding: 0.9rem 1rem;
  }

  .matrix-title {
    font-size: 0.67rem;
    letter-spacing: 0.13em;
    color: var(--color-ink-faint);
    margin-bottom: 0.65rem;
  }

  .matrix-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.6rem;
  }

  .matrix-cell {
    padding: 0.62rem 0.75rem;
    border-radius: var(--radius-sm);
    border: 1px solid var(--color-line-subtle);
    background: rgba(9, 14, 29, 0.72);
    display: flex;
    flex-direction: column;
    gap: 0.18rem;
  }

  .matrix-cell span {
    font-size: 0.65rem;
    letter-spacing: 0.12em;
  }

  .matrix-cell strong {
    font-size: 0.84rem;
    font-weight: 500;
    color: var(--color-ink);
  }

  .matrix-cell.tone-cyan span { color: var(--color-cyan); }
  .matrix-cell.tone-violet span { color: #c4b5fd; }
  .matrix-cell.tone-ember span { color: var(--color-ember); }
  .matrix-cell.tone-emerald span { color: var(--color-emerald); }

  .sub-heading {
    font-size: 0.68rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-ink-faint);
    margin-bottom: 0.45rem;
  }

  .guarantees ul {
    list-style: none;
    display: grid;
    gap: 0.42rem;
  }

  .guarantees li {
    position: relative;
    padding-left: 1.05rem;
    font-size: 0.88rem;
    color: var(--color-ink-soft);
  }

  .guarantees li::before {
    content: "▸";
    position: absolute;
    left: 0;
    color: var(--color-cyan);
  }

  .composition-bar {
    padding-top: 0.9rem;
    border-top: 1px solid var(--color-line-subtle);
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  .composition-text {
    font-size: 0.86rem;
    color: var(--color-ink-soft);
  }

  .jump-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
  }

  .jump-pill {
    font-size: 0.71rem;
    padding: 0.34rem 0.68rem;
    min-height: 2.1rem;
    border-radius: var(--radius-sm);
    border: 1px solid rgba(139, 124, 248, 0.36);
    background: rgba(139, 124, 248, 0.09);
    color: #d6ccff;
    transition: border-color 0.2s var(--ease-out), background 0.2s var(--ease-out);
  }

  .jump-pill:hover {
    border-color: var(--color-cyan);
    background: rgba(110, 231, 255, 0.12);
    color: var(--color-cyan);
  }

  .inspector-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    padding-top: 0.25rem;
  }

  @media (max-width: 960px) {
    .stack-explorer {
      grid-template-columns: 1fr;
    }

    .stack-topology {
      grid-template-columns: 1fr;
    }

    .bus-rail {
      display: none;
    }

    .stack-tabs {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .stack-tab {
      min-height: 4.2rem;
    }

    .stack-tab.is-active {
      transform: none;
    }
  }

  @media (max-width: 560px) {
    .stack-tabs {
      grid-template-columns: 1fr;
    }

    .io-grid {
      grid-template-columns: 1fr;
      gap: 0.45rem;
    }

    .io-arrow {
      transform: rotate(90deg);
      justify-self: start;
    }

    .matrix-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
