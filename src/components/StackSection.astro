---
import AgenticStack from "@components/AgenticStack";
import type { Locale } from "@lib/content";
import { getStackCopy, getStackLayers } from "@lib/stack";

type Props = {
  locale: Locale;
};

const { locale } = Astro.props;
const copy = getStackCopy(locale);
const layers = getStackLayers(locale);
const sectionIndex = locale === "zh" ? "02 · X32 Agentic 工程栈" : "02 · X32 Agentic Stack";
---

<section class="section stack-section" id="agentic-stack">
  {
    layers.map((layer) => (
      <span id={`agentic-stack-${layer.id}`} class="stack-anchor" aria-hidden="true" />
    ))
  }
  <div class="container">
    <div class="section-head reveal">
      <div>
        <span class="section-index">{sectionIndex}</span>
        <h2>{copy.title}</h2>
        <p class="stack-lede">{copy.subtitle}</p>
      </div>
      <a class="more" href={copy.allProjectsHref}>{copy.allProjectsLabel}</a>
    </div>

    <div class="reveal" data-delay="1">
      <AgenticStack client:visible copy={copy} layers={layers} />
    </div>
  </div>
</section>

<style>
  .stack-section {
    position: relative;
  }

  .stack-anchor {
    position: absolute;
    top: 0;
    left: 0;
    width: 1px;
    height: 1px;
    pointer-events: none;
    scroll-margin-top: 5.5rem;
  }

  .stack-lede {
    color: var(--color-ink-soft);
    max-width: 62ch;
    margin-top: 0.9rem;
    font-size: 1rem;
  }
</style>

<style is:global>
  .stack-explorer {
    display: grid;
    grid-template-columns: minmax(0, 0.92fr) minmax(0, 1.28fr);
    gap: clamp(1.4rem, 3vw, 2.2rem);
    align-items: start;
  }

  .stack-topology {
    display: grid;
    grid-template-columns: 3.6rem minmax(0, 1fr);
    gap: 0.75rem;
    align-items: stretch;
  }

  .bus-rail {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding-top: 0.2rem;
  }

  .bus-svg {
    width: 3.5rem;
    height: 22.25rem;
  }

  .bus-caption {
    margin-top: 0.45rem;
    font-size: 0.68rem;
    color: var(--color-ink-faint);
    text-align: center;
    line-height: 1.35;
  }

  .stack-tabs {
    display: grid;
    gap: 0.75rem;
  }

  .stack-tab {
    text-align: left;
    display: flex;
    flex-direction: column;
    gap: 0.24rem;
    min-height: 5.15rem;
    padding: 0.95rem 1.15rem;
    border-radius: var(--radius-md);
    border: 1px solid var(--color-line);
    border-left: 2px solid var(--color-line);
    background: var(--color-bg-raised);
    transition:
      border-color 0.18s var(--ease-out),
      background 0.18s var(--ease-out);
  }

  .stack-tab:hover {
    border-color: var(--color-line-bright);
    background: var(--color-panel);
  }

  .stack-tab.is-linked {
    border-color: rgba(201, 184, 150, 0.24);
  }

  .stack-tab.is-active {
    border-color: var(--color-accent-line);
    border-left: 3px solid var(--color-accent);
    background: var(--color-panel-bright);
  }

  .tab-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.6rem;
  }

  .tab-code {
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--color-accent);
  }

  .tab-badge {
    font-size: 0.72rem;
    color: var(--color-ink-faint);
  }

  .stack-tab.is-active .tab-badge {
    color: var(--color-ink-soft);
  }

  .tab-name {
    font-family: var(--font-display);
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--color-ink);
  }

  .tab-role {
    font-size: 0.84rem;
    color: var(--color-ink-soft);
  }

  .stack-inspector {
    padding: clamp(1.4rem, 3.2vw, 2rem);
    display: flex;
    flex-direction: column;
    gap: 1.3rem;
    min-width: 0;
  }

  .inspector-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.65rem;
  }

  .inspector-chip {
    font-size: 0.76rem;
    color: var(--color-accent);
    padding: 0.22rem 0.62rem;
    border-radius: var(--radius-sm);
    border: 1px solid var(--color-accent-line);
    background: var(--color-accent-soft);
  }

  .inspector-role {
    font-size: 0.78rem;
    color: var(--color-ink-faint);
  }

  .inspector-head h3 {
    font-size: clamp(1.55rem, 2.8vw, 2.1rem);
    margin-top: 0.75rem;
  }

  .inspector-oneliner {
    margin-top: 0.5rem;
    font-size: 1.02rem;
    color: var(--color-ink);
    font-weight: 500;
  }

  .inspector-desc {
    margin-top: 0.5rem;
    font-size: 0.94rem;
    color: var(--color-ink-soft);
  }

  .io-grid {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: 0.85rem;
    align-items: center;
    padding: 0.95rem 1.05rem;
    border-radius: var(--radius-md);
    border: 1px solid var(--color-line-subtle);
    background: var(--color-bg-raised);
  }

  .io-label {
    display: block;
    font-size: 0.72rem;
    color: var(--color-accent);
    margin-bottom: 0.25rem;
  }

  .io-cell p {
    font-size: 0.88rem;
    color: var(--color-ink-soft);
    line-height: 1.48;
  }

  .io-arrow {
    color: var(--color-ink-faint);
    font-size: 1rem;
  }

  .command-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin-bottom: 0.45rem;
    font-size: 0.74rem;
    color: var(--color-ink-faint);
  }

  .copy-btn {
    border: 1px solid var(--color-line-bright);
    background: transparent;
    color: var(--color-ink-soft);
    border-radius: var(--radius-sm);
    padding: 0.25rem 0.7rem;
    font-size: 0.74rem;
    min-height: 1.9rem;
    transition: background 0.18s var(--ease-out), border-color 0.18s var(--ease-out), color 0.18s var(--ease-out);
  }

  .copy-btn:hover {
    background: var(--color-accent-soft);
    border-color: var(--color-accent);
    color: var(--color-ink);
  }

  .copy-btn.is-copied {
    border-color: var(--color-status-ok);
    color: var(--color-status-ok);
  }

  .copy-btn.is-failed {
    border-color: var(--color-status-warn);
    color: var(--color-status-warn);
  }

  .cmd-prompt {
    color: var(--color-accent);
    user-select: none;
    margin-right: 0.4rem;
  }

  .cmd-block code {
    user-select: all;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .instrument-figure {
    border-radius: var(--radius-md);
    overflow: hidden;
    border: 1px solid var(--color-line);
    background: var(--color-bg);
  }

  .instrument-figure img {
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }

  .instrument-figure figcaption {
    padding: 0.65rem 0.95rem;
    font-size: 0.74rem;
    color: var(--color-ink-soft);
    border-top: 1px solid var(--color-line-subtle);
  }

  .spec-matrix {
    border-radius: var(--radius-md);
    border: 1px solid var(--color-line-subtle);
    background: var(--color-bg-raised);
    padding: 1rem 1.05rem;
  }

  .matrix-title {
    font-size: 0.74rem;
    color: var(--color-ink-faint);
    margin-bottom: 0.7rem;
  }

  .matrix-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.65rem;
  }

  .matrix-cell {
    padding: 0.72rem 0.85rem;
    border-radius: var(--radius-sm);
    border: 1px solid var(--color-line-subtle);
    background: var(--color-panel);
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .matrix-cell span {
    font-size: 0.72rem;
    color: var(--color-accent);
  }

  .matrix-cell strong {
    font-size: 0.88rem;
    font-weight: 500;
    color: var(--color-ink);
  }

  .sub-heading {
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--color-ink);
    margin-bottom: 0.45rem;
  }

  .guarantees ul {
    list-style: none;
    display: grid;
    gap: 0.48rem;
  }

  .guarantees li {
    position: relative;
    padding-left: 1rem;
    font-size: 0.92rem;
    color: var(--color-ink-soft);
  }

  .guarantees li::before {
    content: "—";
    position: absolute;
    left: 0;
    color: var(--color-accent);
  }

  .composition-bar {
    padding-top: 1rem;
    border-top: 1px solid var(--color-line-subtle);
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
  }

  .composition-text {
    font-size: 0.9rem;
    color: var(--color-ink-soft);
  }

  .jump-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  .jump-pill {
    font-size: 0.76rem;
    padding: 0.36rem 0.75rem;
    min-height: 2.15rem;
    border-radius: var(--radius-sm);
    border: 1px solid var(--color-line-bright);
    background: var(--color-bg-raised);
    color: var(--color-ink-soft);
    transition: border-color 0.18s var(--ease-out), color 0.18s var(--ease-out);
  }

  .jump-pill:hover {
    border-color: var(--color-accent);
    color: var(--color-ink);
  }

  .inspector-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    padding-top: 0.3rem;
  }

  @media (max-width: 960px) {
    .stack-explorer {
      grid-template-columns: 1fr;
    }

    .stack-topology {
      grid-template-columns: 1fr;
    }

    .bus-rail {
      display: none;
    }

    .stack-tabs {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 560px) {
    .stack-tabs {
      grid-template-columns: 1fr;
    }

    .io-grid {
      grid-template-columns: 1fr;
      gap: 0.45rem;
    }

    .io-arrow {
      transform: rotate(90deg);
      justify-self: start;
    }

    .matrix-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
