---
import WorldVessel from "@components/WorldVessel.astro";
import type { SiteContent } from "@lib/content";
import heroVideo from "../../assets/hero.mp4";
import heroPoster from "../../assets/homepage.png";

type Props = {
  content: SiteContent;
};

const { content } = Astro.props;
const openLabel = content.locale === "zh" ? "进入" : "Enter";
const chapterLabel = content.locale === "zh" ? "章节" : "Chapter";
const scrollLabel = content.locale === "zh" ? "向下探索" : "Scroll to explore";
---

<section class="world-hero" aria-labelledby="world-title">
  <video class="world-media" autoplay muted loop playsinline poster={heroPoster.src} aria-hidden="true">
    <source src={heroVideo} type="video/mp4" />
  </video>
  <div class="world-media-overlay" aria-hidden="true"></div>
  <div class="world-copy">
    <p class="label reveal">{content.hero.eyebrow}</p>
    <h1 id="world-title" class="world-title reveal reveal-delay-1">
      {content.hero.title}
    </h1>
  </div>

  <div class="cockpit" aria-label="X32 Studio entry paths">
    <WorldVessel />
    <div class="mission-meta">
      <p>* Active - Studio 01</p>
      <p>2026 - Shenzhen</p>
      <p>AI agents / product craft</p>
      <p>Flight / dive / hack routes</p>
      <span>{scrollLabel}</span>
    </div>

    <div class="mission-copy">
      <p>{content.hero.subtitle}</p>
      <div class="mission-stats">
        {
          content.hero.stats.map((stat) => (
            <span>
              <strong>{stat.value}</strong>
              {stat.label}
            </span>
          ))
        }
      </div>
    </div>

    <div class="path-console">
      {
        content.hero.paths.map((path, index) => (
          <a class={`console-card console-${path.intent}`} href={path.href}>
            <span class="console-chapter">
              {chapterLabel} {String(index + 1).padStart(2, "0")}
            </span>
            <strong>{path.label}</strong>
            <span>{path.description}</span>
            <em>
              {openLabel} {path.title}
            </em>
          </a>
        ))
      }
    </div>
  </div>
</section>

<style>
  .world-hero {
    background:
      radial-gradient(circle at 50% 15%, rgba(244, 239, 229, 0.16), transparent 26rem),
      radial-gradient(circle at 76% 42%, rgba(191, 63, 29, 0.24), transparent 24rem),
      linear-gradient(145deg, #050505 0%, #171411 54%, #070605 100%);
    border-bottom: 1px solid rgba(247, 241, 229, 0.16);
    color: var(--color-paper);
    margin: 0 calc(var(--space-page) * -1) clamp(2rem, 5vw, 4rem);
    min-height: calc(100vh - 4.6rem);
    overflow: hidden;
    padding: clamp(1.5rem, 4vw, 3rem) var(--space-page);
    position: relative;
  }

  .world-media,
  .world-media-overlay {
    height: 100%;
    inset: 0;
    position: absolute;
    width: 100%;
  }

  .world-media {
    object-fit: cover;
    opacity: 0.72;
  }

  .world-media-overlay {
    background:
      radial-gradient(circle at 58% 34%, rgba(3, 4, 7, 0.02), rgba(3, 4, 7, 0.7) 62%),
      linear-gradient(90deg, rgba(3, 4, 7, 0.96), rgba(3, 4, 7, 0.38) 52%, rgba(3, 4, 7, 0.82));
  }

  .world-hero::before {
    background:
      linear-gradient(rgba(255, 255, 255, 0.03) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.025) 1px, transparent 1px);
    background-size: 46px 46px;
    content: "";
    inset: 0;
    mask-image: radial-gradient(circle at 50% 35%, black, transparent 76%);
    position: absolute;
  }

  .world-copy {
    display: grid;
    gap: 0.65rem;
    max-width: 58rem;
    position: relative;
    z-index: 2;
  }

  .world-title {
    font-family: var(--font-body);
    font-size: clamp(3.3rem, 8.6vw, 9.6rem);
    font-weight: 800;
    letter-spacing: -0.095em;
    line-height: 0.82;
    margin: 0;
    max-width: 11ch;
    text-wrap: balance;
    text-transform: uppercase;
  }

  .cockpit {
    display: grid;
    gap: clamp(1rem, 3vw, 2rem);
    grid-template-columns: 0.72fr minmax(0, 1.15fr) 0.9fr;
    margin-top: clamp(3rem, 9vw, 8rem);
    min-height: 24rem;
    position: relative;
    z-index: 2;
  }

  .mission-meta,
  .mission-copy,
  .path-console {
    align-self: end;
  }

  .mission-meta {
    color: rgba(244, 239, 229, 0.54);
    display: grid;
    font-family: ui-monospace, "SFMono-Regular", Menlo, monospace;
    font-size: 0.68rem;
    gap: 0.55rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .mission-meta p,
  .mission-copy p {
    margin: 0;
  }

  .mission-meta span {
    margin-top: 3rem;
  }

  .mission-copy {
    display: grid;
    gap: 1.2rem;
  }

  .mission-copy p {
    color: rgba(244, 239, 229, 0.72);
    font-size: clamp(1rem, 1.6vw, 1.2rem);
    line-height: 1.62;
    max-width: 34rem;
  }

  .mission-stats {
    display: flex;
    gap: 1rem;
  }

  .mission-stats span {
    color: rgba(244, 239, 229, 0.56);
    font-size: 0.72rem;
    text-transform: uppercase;
  }

  .mission-stats strong {
    color: var(--color-paper);
    display: block;
    font-family: var(--font-display);
    font-size: 2rem;
    line-height: 1;
  }

  .path-console {
    display: grid;
    gap: 0.75rem;
  }

  .console-card {
    background: rgba(5, 5, 5, 0.38);
    border: 1px solid rgba(244, 239, 229, 0.16);
    border-radius: 1rem;
    display: grid;
    gap: 0.55rem;
    padding: 0.9rem;
  }

  .console-chapter,
  .console-card em {
    color: rgba(244, 239, 229, 0.55);
    font-size: 0.68rem;
    font-style: normal;
    font-weight: 900;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .console-card strong {
    color: var(--color-paper);
    font-size: 1.12rem;
  }

  .console-card span:not(.console-chapter) {
    color: rgba(244, 239, 229, 0.66);
    line-height: 1.45;
  }

  .console-card em {
    color: var(--color-accent-soft);
  }

  @media (prefers-reduced-motion: no-preference) {
    .console-card {
      transition:
        background 180ms ease,
        border-color 180ms ease,
        transform 240ms var(--ease-out);
    }

    .console-card:hover {
      background: rgba(244, 239, 229, 0.08);
      border-color: rgba(242, 181, 68, 0.55);
      transform: translateX(-0.45rem);
    }
  }

  @media (max-width: 900px) {
    .world-hero {
      min-height: auto;
    }

    .cockpit {
      grid-template-columns: 1fr;
      margin-top: 2rem;
    }

    .mission-meta {
      display: none;
    }

    .path-console {
      margin-top: 5rem;
    }

    .console-card:hover {
      transform: translateY(-0.25rem);
    }
  }
</style>
