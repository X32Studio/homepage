---
import MissionTelemetry from "@components/MissionTelemetry.astro";
import type { SiteContent } from "@lib/content";

type Props = {
  content: SiteContent;
};

const { content } = Astro.props;
const secondaryExternal = content.hero.secondaryCta.href.startsWith("http");
---

<section class="hero">
  <div class="container hero-deck">
    <div class="hero-narrative">
      <p class="eyebrow rise">
        <span class="status-led is-cyan" aria-hidden="true"></span>
        {content.hero.eyebrow}
      </p>

      <h1 class="rise d1">
        {content.hero.title}
        <span class="gradient-text">{content.hero.titleAccent}</span>
      </h1>

      <p class="subtitle rise d2">{content.hero.subtitle}</p>

      <div class="cta-row rise d3">
        <a class="btn btn-primary" href={content.hero.primaryCta.href}>
          {content.hero.primaryCta.label}
          <span aria-hidden="true">↓</span>
        </a>
        <a
          class="btn btn-ghost"
          href={content.hero.secondaryCta.href}
          target={secondaryExternal ? "_blank" : undefined}
          rel={secondaryExternal ? "noopener noreferrer" : undefined}
        >
          {content.hero.secondaryCta.label}
          <span aria-hidden="true">↗</span>
        </a>
      </div>

      <dl class="stats rise d4">
        {
          content.hero.stats.map((stat) => (
            <div class="stat">
              <dt class="mono-metric">{stat.value}</dt>
              <dd>{stat.label}</dd>
            </div>
          ))
        }
      </dl>
    </div>

    <div class="hero-console rise d2">
      <MissionTelemetry telemetry={content.hero.telemetry} />
    </div>
  </div>

  <div class="container">
    <div class="signal-tape mono-metric rise d4" aria-hidden="true">
      <span><b class="tape-key">BOTTLENECK</b> HUMAN ATTENTION</span>
      <span class="tape-sep">//</span>
      <span><b class="tape-key">PROTOCOL</b> SELF-LOOP v0.4.10</span>
      <span class="tape-sep">//</span>
      <span><b class="tape-key">SHIFT</b> CHAOS MOB → TRUSTWORTHY AGENT ORG</span>
      <span class="tape-sep">//</span>
      <span><b class="tape-key">COMMAND</b> X32 STUDIO · k-r33</span>
    </div>
  </div>
</section>

<style>
  .hero {
    padding-block: clamp(2.8rem, 7vh, 5.2rem) clamp(1.8rem, 4vh, 3rem);
  }

  .hero-deck {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr);
    gap: clamp(2rem, 4.5vw, 3.6rem);
    align-items: center;
  }

  .hero-narrative {
    min-width: 0;
  }

  h1 {
    font-size: clamp(2.85rem, 6.2vw, 5.15rem);
    font-weight: 700;
    line-height: 0.99;
    letter-spacing: -0.045em;
    color: #ffffff;
    margin-top: 1.05rem;
    max-width: 15ch;
  }

  h1 .gradient-text {
    display: block;
    margin-top: 0.14em;
    filter: drop-shadow(0 0 28px rgba(0, 240, 255, 0.24));
  }

  .subtitle {
    max-width: 54ch;
    margin-top: 1.35rem;
    font-size: clamp(1rem, 1.35vw, 1.15rem);
    color: var(--color-ink-soft);
    line-height: 1.62;
  }

  .cta-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
    margin-top: 1.9rem;
  }

  .stats {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
    margin-top: clamp(2.1rem, 5vh, 3rem);
  }

  .stat {
    min-width: 0;
    padding: 0.85rem 0.95rem;
    border: 1px solid var(--color-line-subtle);
    border-top: 2px solid var(--color-cyan);
    background: rgba(7, 10, 16, 0.88);
  }

  .stat dt {
    font-size: clamp(1.55rem, 2.7vw, 2.1rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    color: #ffffff;
  }

  .stat dd {
    font-family: var(--font-mono);
    font-size: 0.69rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-cyan);
    margin-top: 0.28rem;
  }

  .hero-console {
    min-width: 0;
  }

  .signal-tape {
    margin-top: clamp(2.2rem, 5vh, 3.2rem);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.7rem 1.2rem;
    padding: 0.7rem 1rem;
    border-top: 1px solid var(--color-line-bright);
    border-bottom: 1px solid var(--color-line);
    background: rgba(0, 240, 255, 0.045);
    font-size: 0.69rem;
    letter-spacing: 0.12em;
    color: var(--color-ink-soft);
  }

  .tape-key {
    color: var(--color-cyan);
    font-weight: 700;
    margin-right: 0.35rem;
  }

  .tape-sep {
    color: var(--color-ember);
    font-weight: 700;
  }

  @media (max-width: 960px) {
    .hero-deck {
      grid-template-columns: 1fr;
    }

    h1 {
      max-width: 20ch;
    }
  }

  @media (max-width: 520px) {
    .stats {
      grid-template-columns: 1fr;
      gap: 0.75rem;
    }

    .stat {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      gap: 1rem;
    }
  }
</style>
