---
import MissionTelemetry from "@components/MissionTelemetry.astro";
import type { SiteContent } from "@lib/content";

type Props = {
  content: SiteContent;
};

const { content } = Astro.props;
const secondaryExternal = content.hero.secondaryCta.href.startsWith("http");
---

<section class="hero">
  <div class="container hero-deck">
    <div class="hero-narrative">
      <p class="eyebrow rise">
        <span class="status-led is-cyan" aria-hidden="true"></span>
        {content.hero.eyebrow}
      </p>

      <h1 class="rise d1">
        {content.hero.title}
        <span class="gradient-text">{content.hero.titleAccent}</span>
      </h1>

      <p class="subtitle rise d2">{content.hero.subtitle}</p>

      <div class="cta-row rise d3">
        <a class="btn btn-primary" href={content.hero.primaryCta.href}>
          {content.hero.primaryCta.label}
          <span aria-hidden="true">↓</span>
        </a>
        <a
          class="btn btn-ghost"
          href={content.hero.secondaryCta.href}
          target={secondaryExternal ? "_blank" : undefined}
          rel={secondaryExternal ? "noopener noreferrer" : undefined}
        >
          {content.hero.secondaryCta.label}
          <span aria-hidden="true">↗</span>
        </a>
      </div>

      <dl class="stats rise d4">
        {
          content.hero.stats.map((stat) => (
            <div class="stat">
              <dt class="mono-metric">{stat.value}</dt>
              <dd>{stat.label}</dd>
            </div>
          ))
        }
      </dl>
    </div>

    <div class="hero-console rise d2">
      <MissionTelemetry telemetry={content.hero.telemetry} />
    </div>
  </div>
</section>

<style>
  .hero {
    padding-block: clamp(3rem, 7.5vh, 5.5rem) clamp(2.2rem, 5vh, 3.8rem);
  }

  .hero-deck {
    display: grid;
    grid-template-columns: minmax(0, 1.18fr) minmax(0, 0.82fr);
    gap: clamp(2rem, 4.5vw, 3.5rem);
    align-items: center;
  }

  .hero-narrative {
    min-width: 0;
  }

  h1 {
    font-size: clamp(2.45rem, 5.4vw, 4.35rem);
    line-height: 1.08;
    margin-top: 1.15rem;
    max-width: 16ch;
  }

  h1 .gradient-text {
    display: block;
    margin-top: 0.12em;
  }

  .subtitle {
    max-width: 52ch;
    margin-top: 1.35rem;
    font-size: clamp(1rem, 1.35vw, 1.14rem);
    color: var(--color-ink-soft);
  }

  .cta-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
    margin-top: 1.9rem;
  }

  .stats {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.15rem;
    margin-top: clamp(2.1rem, 5vh, 3.2rem);
    padding-top: 1.45rem;
    border-top: 1px solid var(--color-line);
  }

  .stat {
    min-width: 0;
  }

  .stat dt {
    font-size: clamp(1.45rem, 2.6vw, 2rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--color-cyan);
  }

  .stat dd {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-ink-faint);
    margin-top: 0.25rem;
  }

  .hero-console {
    min-width: 0;
  }

  @media (max-width: 960px) {
    .hero-deck {
      grid-template-columns: 1fr;
    }

    h1 {
      max-width: 22ch;
    }
  }

  @media (max-width: 520px) {
    .stats {
      grid-template-columns: 1fr;
      gap: 0.9rem;
    }

    .stat {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      gap: 1rem;
      padding-bottom: 0.65rem;
      border-bottom: 1px solid var(--color-line-subtle);
    }

    .stat:last-child {
      padding-bottom: 0;
      border-bottom: 0;
    }
  }
</style>
