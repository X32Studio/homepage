---
import type { SiteContent } from "@lib/content";

type Props = {
  content: SiteContent;
};

const { content } = Astro.props;
---

<section class="hero">
  <div class="container">
    <p class="eyebrow rise">
      <span class="pulse-dot"></span>
      {content.hero.eyebrow}
    </p>
    <h1 class="rise d1">
      {content.hero.title}
      <span class="gradient-text">{content.hero.titleAccent}</span>
    </h1>
    <p class="subtitle rise d2">{content.hero.subtitle}</p>
    <div class="cta-row rise d3">
      <a class="btn btn-primary" href={content.hero.primaryCta.href}>{content.hero.primaryCta.label}</a>
      <a class="btn btn-ghost" href={content.hero.secondaryCta.href}>{content.hero.secondaryCta.label}</a>
    </div>
    <dl class="stats rise d4">
      {
        content.hero.stats.map((stat) => (
          <div class="stat">
            <dt>{stat.value}</dt>
            <dd>{stat.label}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>

<style>
  .hero {
    padding-block: clamp(4.5rem, 12vh, 8.5rem) clamp(2.5rem, 7vh, 5rem);
  }

  h1 {
    font-size: clamp(2.6rem, 7vw, 4.9rem);
    max-width: 18ch;
    margin-top: 1.3rem;
  }

  .subtitle {
    max-width: 44ch;
    margin-top: 1.6rem;
    font-size: clamp(1.02rem, 1.6vw, 1.22rem);
    color: var(--color-ink-soft);
  }

  .cta-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
    margin-top: 2.3rem;
  }

  .stats {
    display: flex;
    gap: clamp(2.2rem, 6vw, 4.5rem);
    margin-top: clamp(2.8rem, 7vh, 4.5rem);
    border-top: 1px solid var(--color-line);
    padding-top: 1.8rem;
  }

  .stat dt {
    font-family: var(--font-display);
    font-size: clamp(1.7rem, 3.4vw, 2.4rem);
    font-weight: 700;
    background: var(--gradient-aurora);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .stat dd {
    font-family: var(--font-mono);
    font-size: 0.76rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-ink-faint);
    margin-top: 0.25rem;
  }
</style>
