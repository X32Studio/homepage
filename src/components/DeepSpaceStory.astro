---
import type { Product, SiteContent } from "@lib/content";
import "@styles/deep-space-story.css";
import agenticImage from "../../assets/agentic.png";
import geekImage from "../../assets/geek.png";
import heroVideo from "../../assets/hero.mp4";
import heroPoster from "../../assets/homepage.png";
import newbieImage from "../../assets/newbee.png";
import notesImage from "../../assets/notes.png";

type Props = {
  content: SiteContent;
  products: Product[];
};

const { content, products } = Astro.props;
const productImages = {
  agentic: agenticImage,
  geek: geekImage,
  newbie: newbieImage,
};
const labels =
  content.locale === "zh"
    ? {
        enter: "进入",
        scroll: "继续下潜",
        modules: "选择任务舱",
        archive: "打开航行笔记",
        crew: "查看船员档案",
        signal: "接收地面信号",
      }
    : {
        enter: "Enter",
        scroll: "Continue descent",
        modules: "Choose a mission bay",
        archive: "Open the field notebook",
        crew: "View crew manifest",
        signal: "Receive ground signal",
      };
---

<article class="space-story" aria-labelledby="space-title">
  <video class="story-video" autoplay muted loop playsinline poster={heroPoster.src} aria-hidden="true">
    <source src={heroVideo} type="video/mp4" />
  </video>
  <div class="story-shade" aria-hidden="true"></div>

  <section class="story-scene launch-scene" aria-labelledby="space-title">
    <div class="hud hud-left" aria-hidden="true">
      <span>* ACTIVE // X32</span>
      <span>VECTOR: DEEP SPACE</span>
      <span>CREW: 02</span>
      <span>MODE: EXPLORE</span>
    </div>
    <div class="launch-copy">
      <p class="mission-kicker">{content.hero.eyebrow}</p>
      <h1 id="space-title">{content.hero.title}</h1>
      <p>{content.hero.subtitle}</p>
    </div>
    <div class="orbital-map" aria-hidden="true">
      <span class="orbit orbit-one"></span>
      <span class="orbit orbit-two"></span>
      <span class="craft"></span>
      <span class="burn"></span>
    </div>
    <div class="scroll-cue">{labels.scroll}</div>
  </section>

  <section class="story-scene modules-scene" aria-labelledby="modules-title">
    <div class="scene-copy">
      <p class="mission-kicker">{labels.modules}</p>
      <h2 id="modules-title">{content.labsIntro.title}</h2>
      <p>{content.labsIntro.body}</p>
    </div>
    <div class="portal-field">
      {products.map((product) => {
        const image = productImages[product.lab];
        return (
          <a class={`portal portal-${product.lab}`} href={`/products/#${product.id}`}>
            <span>{product.status}</span>
            <img src={image.src} alt="" loading="lazy" />
            <strong>{product.name}</strong>
            <p>{product.summary}</p>
            <em>{labels.enter} {product.name}</em>
          </a>
        );
      })}
    </div>
  </section>

  <section class="story-scene archive-scene" aria-labelledby="archive-title">
    <figure class="notebook-portal">
      <img src={notesImage.src} alt="" loading="lazy" />
      <figcaption>{labels.archive}</figcaption>
    </figure>
    <div class="scene-copy">
      <p class="mission-kicker">{content.channels.eyebrow}</p>
      <h2 id="archive-title">{content.channels.title}</h2>
      <p>{content.channels.body}</p>
    </div>
    <div class="signal-cluster">
      {content.channels.items.map((item) => (
        <article>
          <span>{item.status}</span>
          <strong>{item.title}</strong>
        </article>
      ))}
    </div>
  </section>

  <section class="story-scene crew-scene" aria-labelledby="crew-title">
    <div class="scene-copy">
      <p class="mission-kicker">{labels.crew}</p>
      <h2 id="crew-title">{content.about.title}</h2>
      <p>{content.about.body}</p>
    </div>
    <div class="crew-console">
      {content.about.capabilities.map((item) => <span>{item}</span>)}
    </div>
    <div class="mission-rules">
      {content.studio.principles.map((item, index) => (
        <p>
          <strong>{String(index + 1).padStart(2, "0")}</strong>
          {item}
        </p>
      ))}
    </div>
  </section>

  <section class="story-scene signal-scene" aria-labelledby="signal-title">
    <div class="scene-copy">
      <p class="mission-kicker">{labels.signal}</p>
      <h2 id="signal-title">{content.links.title}</h2>
    </div>
    <div class="ground-links">
      {content.links.items.map((item) => (
        <a href={item.href}>
          <span>Transmission</span>
          <strong>{item.label}</strong>
          <p>{item.note}</p>
        </a>
      ))}
    </div>
  </section>
</article>
