---
import type { SiteContent } from "@lib/content";

type Props = {
  content: SiteContent;
  full?: boolean;
};

const { content, full = false } = Astro.props;
---

<section class:list={["section", "about-section", full && "about-section-full"]}>
  <div>
    <p class="label">{content.about.eyebrow}</p>
    <h1 class="section-title">{content.about.title}</h1>
  </div>
  <div class="about-body">
    <p class="body-copy">{content.about.body}</p>
    <div class="capability-grid">
      {content.about.capabilities.map((item) => <span>{item}</span>)}
    </div>
  </div>
</section>

<style>
  .about-section {
    display: grid;
    gap: clamp(2rem, 5vw, 4rem);
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  }

  .about-section-full {
    min-height: 62vh;
  }

  .about-body {
    display: grid;
    gap: 2rem;
  }

  .capability-grid {
    display: grid;
    gap: 0.75rem;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .capability-grid span {
    border-left: 2px solid var(--color-accent);
    color: var(--color-ink);
    font-weight: 800;
    padding-left: 0.8rem;
  }

  @media (max-width: 760px) {
    .about-section,
    .capability-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
