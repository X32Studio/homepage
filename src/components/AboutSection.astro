---
import type { SiteContent } from "@lib/content";

type Props = {
  content: SiteContent;
  full?: boolean;
};

const { content, full = false } = Astro.props;
---

<section class:list={["section", "about-section", full && "about-section-full"]}>
  <div>
    <p class="label">{content.about.eyebrow}</p>
    <h1 class="section-title">{content.about.title}</h1>
  </div>
  <div class="about-body">
    <p class="body-copy">{content.about.body}</p>
    <div class="capability-grid">
      {content.about.capabilities.map((item) => <span>{item}</span>)}
    </div>
  </div>
</section>

<style>
  .about-section {
    display: grid;
    gap: clamp(2rem, 5vw, 4rem);
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    position: relative;
  }

  .about-section::before {
    color: rgba(247, 241, 229, 0.08);
    content: "CREW // MANIFEST";
    font-family: ui-monospace, "SFMono-Regular", Menlo, monospace;
    font-size: clamp(2rem, 7vw, 6rem);
    font-weight: 900;
    letter-spacing: 0.04em;
    position: absolute;
    right: 0;
    top: -1rem;
    z-index: -1;
  }

  .about-section-full {
    min-height: 62vh;
  }

  .about-body {
    display: grid;
    gap: 2rem;
  }

  .capability-grid {
    display: grid;
    gap: 0.75rem;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .capability-grid span {
    border-left: 2px solid var(--color-accent);
    background: rgba(247, 241, 229, 0.045);
    border-radius: 0.8rem;
    color: var(--color-ink);
    padding: 0.75rem 0.8rem;
    font-weight: 800;
  }

  @media (max-width: 760px) {
    .about-section,
    .capability-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
