---
import type { CollectionEntry } from "astro:content";

type Props = {
  project: CollectionEntry<"projects">;
};

const { project } = Astro.props;
const { name, tagline, github, docs, status, glyph, tags, cover, order } = project.data;
const layerLabel = `Layer 0${order}`;
---

<article class="card project-card">
  {
    cover && (
      <div class="cover">
        <img src={cover} alt={`${name} architectural preview`} width="640" height="360" loading="lazy" />
      </div>
    )
  }
  <div class="card-top">
    <div class="glyph-cluster">
      <span class="glyph" aria-hidden="true">{glyph}</span>
      <span class="layer-code mono-metric">{layerLabel}</span>
    </div>
    <span class="status-chip">{status}</span>
  </div>
  <h3>{name}</h3>
  <p class="tagline">{tagline}</p>
  <div class="project-body">
    <slot />
  </div>
  <div class="tags">
    {tags.map((tag) => <span>{tag}</span>)}
  </div>
  <div class="card-links">
    {
      github && (
        <a href={github} target="_blank" rel="noopener noreferrer" aria-label={`${name} on GitHub`}>
          <svg width="15" height="15" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
            <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z" />
          </svg>
          GitHub ↗
        </a>
      )
    }
    {
      docs && (
        <a href={docs} target="_blank" rel="noopener noreferrer" aria-label={`${name} documentation`}>
          Docs ↗
        </a>
      )
    }
  </div>
</article>

<style>
  .cover {
    margin: -1.65rem -1.65rem 0.4rem;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-bottom: 1px solid var(--color-line);
    background: var(--color-bg-raised);
  }

  .cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s var(--ease-out);
  }

  .project-card:hover .cover img {
    transform: scale(1.025);
  }

  .project-body:empty {
    display: none;
  }

  .project-body :global(p) {
    color: var(--color-ink-soft);
    font-size: 0.92rem;
    margin-bottom: 0.7rem;
  }

  .project-body :global(p:last-child) {
    margin-bottom: 0;
  }

  .project-body :global(strong) {
    color: var(--color-ink);
  }

  .project-body :global(code) {
    font-family: var(--font-mono);
    font-size: 0.85em;
    color: var(--color-accent);
    background: var(--color-bg-raised);
    border: 1px solid var(--color-line-subtle);
    padding: 0.08em 0.35em;
    border-radius: var(--radius-sm);
  }
</style>
