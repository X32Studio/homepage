---
type Props = { locale: "en" | "zh" };

const { locale } = Astro.props;

const copy = {
  eyebrow: { en: "Flagship instrument", zh: "旗舰仪器" },
  title: { en: "Argus — the research tree, live.", zh: "Argus —— 正在生长的研究树。" },
  body: {
    en: "Type one command. Argus starts digging, keeps every source, note and claim in one growing structure, and writes a report that gets sharper each pass. This is the dashboard you come back to.",
    zh: "敲一条命令。Argus 开始深挖，把来源、笔记和观点沉淀进一棵不断生长的结构里，报告一轮比一轮更锐利。这就是你会反复回来的仪表盘。",
  },
  cta: { en: "Get Argus", zh: "获取 Argus" },
  cmd: { en: "git clone … && /argus init", zh: "git clone … && /argus init" },
};

const { eyebrow, title, body, cta, cmd } = copy;
const t = (pair: { en: string; zh: string }) => pair[locale];
---

<section class="showcase section">
  <div class="container">
    <div class="showcase-panel reveal">
      <div class="panel-copy">
        <p class="eyebrow">{t(eyebrow)}</p>
        <h2>{t(title)}</h2>
        <p class="body">{t(body)}</p>
        <div class="terminal">
          <span class="prompt">$</span>
          <span class="typing">{t(cmd)}</span>
          <span class="cursor"></span>
        </div>
        <a class="btn btn-primary" href="https://github.com/X32Studio/Argus" rel="noopener">
          {t(cta)}
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </a>
      </div>
      <div class="panel-shot">
        <img
          src="/assets/argus-dashboard.webp"
          alt="Argus research dashboard showing a growing knowledge graph"
          width="1600"
          height="900"
          loading="lazy"
        />
        <div class="glow"></div>
      </div>
    </div>
  </div>
</section>

<style>
  .showcase {
    padding-top: 0;
  }

  .showcase-panel {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
    border-radius: var(--radius-lg);
    border: 1px solid var(--color-line);
    background: linear-gradient(140deg, rgba(110, 231, 255, 0.06), rgba(167, 139, 250, 0.08), transparent);
    padding: clamp(1.7rem, 4vw, 3rem);
    position: relative;
    overflow: hidden;
  }

  .panel-copy h2 {
    font-size: clamp(1.7rem, 3.4vw, 2.5rem);
    margin-top: 0.7rem;
  }

  .panel-copy .body {
    color: var(--color-ink-soft);
    margin-top: 1rem;
    max-width: 42ch;
  }

  .terminal {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 1.4rem 0 1.6rem;
    padding: 0.75rem 1rem;
    border-radius: var(--radius-sm);
    background: var(--color-bg-raised);
    border: 1px solid var(--color-line);
    font-family: var(--font-mono);
    font-size: 0.82rem;
    color: var(--color-ink-soft);
    overflow: hidden;
    white-space: nowrap;
  }

  .terminal .prompt {
    color: var(--color-cyan);
  }

  .typing {
    color: var(--color-ink);
  }

  .cursor {
    width: 0.6em;
    height: 1.1em;
    background: var(--color-cyan);
    animation: blink 1s steps(1) infinite;
  }

  @keyframes blink {
    50% {
      opacity: 0;
    }
  }

  .panel-shot {
    position: relative;
  }

  .panel-shot img {
    width: 100%;
    border-radius: var(--radius-md);
    border: 1px solid var(--color-line-bright);
    box-shadow: 0 30px 70px rgba(0, 0, 0, 0.45);
  }

  .glow {
    position: absolute;
    inset: -10%;
    z-index: -1;
    background: radial-gradient(60% 60% at 60% 40%, rgba(110, 231, 255, 0.14), transparent 70%);
    filter: blur(16px);
  }

  @media (max-width: 860px) {
    .showcase-panel {
      grid-template-columns: 1fr;
    }

    .terminal {
      white-space: normal;
      word-break: break-all;
    }
  }
</style>
