---
import type { SiteContent } from "@lib/content";

type Props = {
  content: SiteContent;
};

const { content } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div>
        <a class="brand-mark" href="/">
          <span class="brand-symbol">X32</span>
          <span class="brand-word">Studio</span>
        </a>
        <p class="tagline">{content.footer.tagline}</p>
      </div>
      <div class="footer-links">
        {content.footer.links.map((link) => <a href={link.href} rel="noopener">{link.label}</a>)}
      </div>
    </div>
    <div class="meta-row">
      <span>© {year} {content.footer.copyright}</span>
      <span>Deep space operations · x32studio.com</span>
    </div>
  </div>
</footer>
