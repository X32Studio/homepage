---
import type { Product } from "@lib/content";
import agenticImage from "../../assets/agentic.png";
import geekImage from "../../assets/geek.png";
import newbieImage from "../../assets/newbee.png";

type Props = {
  product: Product;
  index: number;
};

const { product, index } = Astro.props;
const number = String(index + 1).padStart(2, "0");
const labImages = {
  agentic: agenticImage,
  geek: geekImage,
  newbie: newbieImage,
};
const image = labImages[product.lab];
---

<article class="product-card hover-lift">
  <img src={image.src} alt="" class="product-image" loading="lazy" />
  <div class="product-number">{number}</div>
  <div>
    <p class="product-status">{product.status}</p>
    <h3>{product.name}</h3>
    <p>{product.summary}</p>
  </div>
  <div class="product-meta">
    <span>{product.audience}</span>
    <ul>
      {product.tags.map((tag) => <li>{tag}</li>)}
    </ul>
  </div>
</article>

<style>
  .product-card {
    background:
      linear-gradient(135deg, rgba(247, 241, 229, 0.08), rgba(247, 241, 229, 0.02)),
      var(--color-panel);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-lg);
    display: grid;
    gap: 1.4rem;
    grid-template-columns: minmax(10rem, 0.7fr) 3rem minmax(0, 1fr) minmax(12rem, 0.8fr);
    padding: clamp(1rem, 2.6vw, 1.6rem);
    position: relative;
  }

  .product-card::before {
    border: 1px solid rgba(247, 184, 79, 0.22);
    border-radius: inherit;
    content: "";
    inset: 0.45rem;
    pointer-events: none;
    position: absolute;
  }

  .product-image {
    align-self: stretch;
    aspect-ratio: 4 / 3;
    border-radius: 1rem;
    filter: saturate(0.82) contrast(1.08) brightness(0.82);
    height: 100%;
    min-height: 11rem;
    object-fit: cover;
    width: 100%;
  }

  .product-number,
  .product-status {
    color: var(--color-accent);
    font-size: 0.74rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .product-number {
    align-self: start;
    border: 1px solid var(--color-line);
    border-radius: 999px;
    display: grid;
    height: 2.4rem;
    place-items: center;
    width: 2.4rem;
  }

  h3 {
    font-family: var(--font-display);
    font-size: clamp(2rem, 4vw, 4rem);
    font-weight: 500;
    letter-spacing: -0.06em;
    line-height: 0.92;
    margin: 0.25rem 0 0.8rem;
  }

  p {
    color: var(--color-ink-soft);
    line-height: 1.55;
    margin: 0;
  }

  .product-meta {
    display: grid;
    gap: 1rem;
  }

  .product-meta span {
    font-weight: 800;
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  li {
    border: 1px solid var(--color-line);
    border-radius: 999px;
    color: var(--color-ink-soft);
    font-size: 0.78rem;
    padding: 0.34rem 0.55rem;
  }

  @media (max-width: 820px) {
    .product-card {
      grid-template-columns: 1fr;
    }
  }
</style>
