---
import ProductPageIntro from "@components/ProductPageIntro.astro";
import ProductShowcase from "@components/ProductShowcase.astro";
import BaseLayout from "@layouts/BaseLayout.astro";
import { getAlternateLocalePath, getProducts, getSiteContent } from "@lib/content";

const locale = "en";
const content = getSiteContent(locale);
const products = getProducts(locale);
const alternatePath = getAlternateLocalePath(locale, Astro.url.pathname);
---

<BaseLayout content={content} locale={locale} alternatePath={alternatePath} title="Products">
  <ProductPageIntro content={content} products={products} />
  <ProductShowcase products={products} />
</BaseLayout>
