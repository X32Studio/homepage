---
import ArgusShowcase from "@components/ArgusShowcase.astro";
import Hero from "@components/Hero.astro";
import ProjectCard from "@components/ProjectCard.astro";
import BaseLayout from "@layouts/BaseLayout.astro";
import { getAlternateLocalePath, getSiteContent } from "@lib/content";
import { getCollection } from "astro:content";

const locale = "zh";
const content = getSiteContent(locale);
const alternatePath = getAlternateLocalePath(locale, Astro.url.pathname);

const allProjects = await getCollection("projects", ({ data }) => data.visibility === "public" && data.locale === locale);
allProjects.sort((left, right) => left.data.order - right.data.order);

const posts = (await getCollection("blog", ({ data }) => !data.draft && data.locale === locale)).sort(
  (left, right) => right.data.pubDate.valueOf() - left.data.pubDate.valueOf(),
);
---

<BaseLayout content={content} locale={locale} alternatePath={alternatePath}>
  <Hero content={content} />
  <ArgusShowcase locale="zh" />

  <section class="section">
    <div class="container">
      <div class="section-head reveal">
        <div>
          <p class="eyebrow">{content.projectsIntro.eyebrow}</p>
          <h2>{content.projectsIntro.title}</h2>
        </div>
        <a class="more" href="/zh/projects/">全部项目 →</a>
      </div>
      <div class="project-grid">
        {
          allProjects.map((project, index) => (
            <div class="reveal" data-delay={String((index % 3) + 1)}>
              <ProjectCard project={project} />
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head reveal">
        <div>
          <p class="eyebrow">{content.blogIntro.eyebrow}</p>
          <h2>{content.blogIntro.title}</h2>
        </div>
        <a class="more" href="/zh/blog/">全部笔记 →</a>
      </div>
      <div class="reveal">
        {
          posts.slice(0, 4).map((post) => (
            <article class="post-row">
              <time datetime={post.data.pubDate.toISOString()}>{post.data.pubDate.toISOString().slice(0, 10)}</time>
              <h3><a href={`/zh/blog/${post.data.postSlug}/`}>{post.data.title}</a></h3>
              <span class="lang-tag">中文</span>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="about-panel reveal">
        <div>
          <p class="eyebrow">{content.aboutTeaser.eyebrow}</p>
          <h2>{content.aboutTeaser.title}</h2>
          <p class="body">{content.aboutTeaser.body}</p>
          <a class="btn btn-ghost" href={content.aboutTeaser.cta.href}>{content.aboutTeaser.cta.label}</a>
        </div>
        <ul class="capabilities">
          {content.aboutTeaser.capabilities.map((item) => <li>{item}</li>)}
        </ul>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero + .section {
    padding-top: 0;
  }

  .about-panel {
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
    border-radius: var(--radius-lg);
    border: 1px solid var(--color-line);
    background: linear-gradient(140deg, rgba(110, 231, 255, 0.05), rgba(167, 139, 250, 0.07) 55%, transparent);
    padding: clamp(2rem, 5vw, 3.8rem);
  }

  .about-panel h2 {
    font-size: clamp(1.7rem, 3.6vw, 2.4rem);
    margin-top: 0.65rem;
  }

  .about-panel .body {
    color: var(--color-ink-soft);
    margin-block: 1.1rem 1.7rem;
    max-width: 52ch;
  }

  .capabilities {
    list-style: none;
    display: grid;
    gap: 0.75rem;
  }

  .capabilities li {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--color-ink-soft);
    display: flex;
    align-items: center;
    gap: 0.7rem;
  }

  .capabilities li::before {
    content: "▸";
    color: var(--color-cyan);
  }

  @media (max-width: 760px) {
    .about-panel {
      grid-template-columns: 1fr;
    }
  }
</style>
