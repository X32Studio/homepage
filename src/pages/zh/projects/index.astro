---
import ProjectCard from "@components/ProjectCard.astro";
import BaseLayout from "@layouts/BaseLayout.astro";
import { getAlternateLocalePath, getSiteContent } from "@lib/content";
import { getCollection } from "astro:content";

const locale = "zh";
const content = getSiteContent(locale);
const alternatePath = getAlternateLocalePath(locale, Astro.url.pathname);

const projects = await getCollection("projects", ({ data }) => data.visibility === "public" && data.locale === locale);
projects.sort((left, right) => left.data.order - right.data.order);
---

<BaseLayout content={content} locale={locale} alternatePath={alternatePath}>
  <section class="section">
    <div class="container">
      <p class="eyebrow reveal">{content.projectsIntro.eyebrow}</p>
      <h1 class="page-title reveal" data-delay="1">{content.projectsIntro.title}</h1>
      <p class="lede reveal" data-delay="2">{content.projectsIntro.body}</p>
      <div class="project-grid">
        {
          projects.map((project, index) => (
            <div class="reveal" data-delay={String((index % 3) + 1)}>
              <ProjectCard project={project}>
                <Fragment set:html={project.body} />
              </ProjectCard>
            </div>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .page-title {
    font-size: clamp(2.2rem, 5.4vw, 3.6rem);
    margin-top: 0.9rem;
  }

  .lede {
    color: var(--color-ink-soft);
    max-width: 56ch;
    margin-top: 1.1rem;
  }

  .project-grid {
    margin-top: clamp(2.4rem, 6vw, 3.8rem);
  }
</style>
