---
import BaseLayout from "@layouts/BaseLayout.astro";
import { getAlternateLocalePath, getSiteContent } from "@lib/content";

const locale = "zh";
const content = getSiteContent(locale);
const alternatePath = getAlternateLocalePath(locale, Astro.url.pathname);

const crew = [
  {
    initial: "R",
    name: "Ruiyuan Kang",
    role: "创始人 · Agentic 核心",
    bio: "X32 Studio 创始人。在全球顶级量化金融公司带领 AI 团队；此前任阿联酋国家技术创新研究院（TII）高级研究员、agentic team lead，主导多项国家级 agentic AI 研究项目。这里是他的个人开源作品集。",
  },
  {
    initial: "V",
    name: "Vera Xian",
    role: "联合创始人 · 产品",
    bio: "多年海内外大厂资深 PM / 产品高管。亲手 vibe coding 过多款产品，从想法到上线全程打通。",
  },
  {
    initial: "◈",
    name: "不具名的建造者",
    role: "Off the record",
    bio: "X32 的项目里还有大厂 P7+ 高工和大模型训练者的参与。有些贡献者不便具名——他们的工作在代码里，不在简历墙上。",
  },
];
---

<BaseLayout content={content} locale={locale} alternatePath={alternatePath} title="关于">
  <section class="section">
    <div class="container narrow">
      <p class="eyebrow reveal">{content.aboutTeaser.eyebrow}</p>
      <h1 class="page-title reveal" data-delay="1">{content.aboutTeaser.title}</h1>
      <div class="prose reveal" data-delay="2">
        <p>
          X32 Studio 是一支精英 geek 小队，在有用技术的边缘做东西——agentic 系统、开发者工具，
          以及能解决真实问题（而不只是演示好看）的手作软件。
        </p>
      </div>
    </div>

    <div class="container crew-wrap">
      <div class="crew-grid">
        {
          crew.map((member, index) => (
            <article class="card crew-card reveal" data-delay={String(index + 1)}>
              <span class="avatar" aria-hidden="true">{member.initial}</span>
              <div>
                <h2>{member.name}</h2>
                <p class="role">{member.role}</p>
              </div>
              <p class="bio">{member.bio}</p>
            </article>
          ))
        }
      </div>
    </div>

    <div class="container narrow">
      <div class="prose reveal">
        <h2>我们的工作方式</h2>
        <ul>
          <li>公开建造：代码、笔记和决策都保持可见。</li>
          <li>要仪器，不要仪表盘：你能拥有的工具胜过你只能观看的指标。</li>
          <li>能用了才发布：不做期货，不画大饼。</li>
        </ul>
        <h2>找到我们</h2>
        <p>
          代码在 <a href="https://github.com/X32Studio" rel="noopener">GitHub</a>，
          合作与产品交流请写信到
          <a href="mailto:hello@x32studio.com">hello@x32studio.com</a>。
        </p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .narrow {
    max-width: 46rem;
  }

  .page-title {
    font-size: clamp(2.2rem, 5.4vw, 3.6rem);
    margin-top: 0.9rem;
  }

  .crew-wrap {
    margin-top: clamp(2.2rem, 5vw, 3.2rem);
  }

  .crew-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(17rem, 100%), 1fr));
    gap: 1.4rem;
  }

  .crew-card h2 {
    font-size: 1.25rem;
  }

  .crew-card .role {
    font-family: var(--font-mono);
    font-size: 0.74rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-cyan);
    margin-top: 0.3rem;
  }

  .crew-card .bio {
    color: var(--color-ink-soft);
    font-size: 0.95rem;
  }

  .avatar {
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border-radius: 50%;
    background: rgba(167, 139, 250, 0.1);
    border: 1px solid var(--color-line-bright);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.15rem;
    color: var(--color-violet);
  }

  @media (max-width: 640px) {
    .crew-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<style is:global>
  .prose {
    margin-top: 2.2rem;
    color: var(--color-ink-soft);
  }

  .prose h2 {
    color: var(--color-ink);
    font-size: 1.6rem;
    margin-block: 2.2rem 0.9rem;
  }

  .prose p {
    margin-block: 1rem;
  }

  .prose a {
    color: var(--color-ink);
    border-bottom: 1px solid var(--color-line-bright);
  }

  .prose a:hover {
    color: var(--color-cyan);
    border-color: var(--color-cyan);
  }

  .prose ul {
    padding-left: 1.4rem;
    display: grid;
    gap: 0.45rem;
    margin-block: 1rem;
  }
</style>
