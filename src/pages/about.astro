---
import BaseLayout from "@layouts/BaseLayout.astro";
import { getAlternateLocalePath, getSiteContent } from "@lib/content";

const locale = "en";
const content = getSiteContent(locale);
const alternatePath = getAlternateLocalePath(locale, Astro.url.pathname);

const crew = [
  {
    initial: "R",
    name: "Ruiyuan Kang",
    role: "Founder · Agentic core",
    bio: "Founder of X32 Studio. Leads an AI team at a global quantitative finance firm. Previously Senior Researcher and agentic team lead at the UAE's Technology Innovation Institute, driving national-scale agentic AI research programs. Everything here is his independent open-source work.",
  },
  {
    initial: "V",
    name: "Vera Xian",
    role: "Co-founder · Product",
    bio: "Years as a senior PM / product executive across major tech companies, in China and overseas. Has vibe-coded multiple products herself — from idea to shipped.",
  },
  {
    initial: "◈",
    name: "The quiet builders",
    role: "Off the record",
    bio: "X32 projects are also built with P7+ senior engineers from major tech companies and people who train frontier models. Some contribute unnamed — their work shows up in the repos, not on this wall.",
  },
];
---

<BaseLayout content={content} locale={locale} alternatePath={alternatePath} title="About">
  <section class="section">
    <div class="container narrow">
      <p class="eyebrow reveal">{content.aboutTeaser.eyebrow}</p>
      <h1 class="page-title reveal" data-delay="1">{content.aboutTeaser.title}</h1>
      <div class="prose reveal" data-delay="2">
        <p>
          X32 Studio is an elite geek crew working at the edge of useful technology — agentic systems,
          developer tools, and handmade software that solves real problems instead of demoing well.
        </p>
      </div>
    </div>

    <div class="container crew-wrap">
      <div class="crew-grid">
        {
          crew.map((member, index) => (
            <article class="card crew-card reveal" data-delay={String(index + 1)}>
              <span class="avatar" aria-hidden="true">{member.initial}</span>
              <div>
                <h2>{member.name}</h2>
                <p class="role">{member.role}</p>
              </div>
              <p class="bio">{member.bio}</p>
            </article>
          ))
        }
      </div>
    </div>

    <div class="container narrow">
      <div class="prose reveal">
        <h2>How we work</h2>
        <ul>
          <li>Build in public: repos, notes, and decisions stay visible.</li>
          <li>Instruments over dashboards: tools you own beat metrics you watch.</li>
          <li>Ship when it works: no vaporware, no roadmap theater.</li>
        </ul>
        <h2>Find us</h2>
        <p>
          On <a href="https://github.com/X32Studio" rel="noopener">GitHub</a> for code, or
          <a href="mailto:hello@x32studio.com">hello@x32studio.com</a> for collaborations and product
          conversations.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .narrow {
    max-width: 46rem;
  }

  .page-title {
    font-size: clamp(2.2rem, 5.4vw, 3.6rem);
    margin-top: 0.9rem;
  }

  .crew-wrap {
    margin-top: clamp(2.2rem, 5vw, 3.2rem);
  }

  .crew-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(17rem, 100%), 1fr));
    gap: 1.4rem;
  }

  .crew-card h2 {
    font-size: 1.25rem;
  }

  .crew-card .role {
    font-family: var(--font-mono);
    font-size: 0.74rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-cyan);
    margin-top: 0.3rem;
  }

  .crew-card .bio {
    color: var(--color-ink-soft);
    font-size: 0.95rem;
  }

  .avatar {
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border-radius: 50%;
    background: rgba(167, 139, 250, 0.1);
    border: 1px solid var(--color-line-bright);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.15rem;
    color: var(--color-violet);
  }

  @media (max-width: 640px) {
    .crew-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<style is:global>
  .prose {
    margin-top: 2.2rem;
    color: var(--color-ink-soft);
  }

  .prose h2 {
    color: var(--color-ink);
    font-size: 1.6rem;
    margin-block: 2.2rem 0.9rem;
  }

  .prose p {
    margin-block: 1rem;
  }

  .prose a {
    color: var(--color-ink);
    border-bottom: 1px solid var(--color-line-bright);
  }

  .prose a:hover {
    color: var(--color-cyan);
    border-color: var(--color-cyan);
  }

  .prose ul {
    padding-left: 1.4rem;
    display: grid;
    gap: 0.45rem;
    margin-block: 1rem;
  }
</style>
